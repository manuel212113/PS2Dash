<Window x:Class="PS2Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PS2Desktop"
        xmlns:vistas="clr-namespace:PS2Desktop.Vistas"
        Title="PS2 Demo Downloader" Height="750" Width="1150"
        Background="Transparent" WindowStyle="None" AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="25" GlassFrameThickness="0" ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="25" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" MouseDown="Border_MouseDown"
            KeyDown="Window_KeyDown">
        <Grid>
            <Grid x:Name="LayoutGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource SidebarBrush}" CornerRadius="20" Margin="10">
                    <Grid>
                        <StackPanel>
                            <Image Height="80" Source="/Imagenes/logops2app.png" Stretch="Uniform" Width="169" Margin="0,10,0,20"/>

                            <Button x:Name="BtnHome" Style="{StaticResource MenuButtonStyle}" Foreground="White" Background="#252A3D" Click="BtnHome_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M23.121 9.069 15.536 1.483a5.008 5.008 0 0 0-7.072 0L.879 9.069A2.978 2.978 0 0 0 0 11.19v9.817a3 3 0 0 0 3 3H21a3 3 0 0 0 3-3V11.19A2.978 2.978 0 0 0 23.121 9.069ZM15 22.007H9V18.073a3 3 0 0 1 6 0Zm7-1a1 1 0 0 1-1 1H17V18.073a5 5 0 0 0-10 0v3.934H3a1 1 0 0 1-1-1V11.19a1.008 1.008 0 0 1 .293-.707L9.878 2.9a3.008 3.008 0 0 1 4.244 0l7.585 7.586A1.008 1.008 0 0 1 22 11.19Z" 
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                          Stretch="Uniform" Width="20" Height="20" Margin="0,0,15,0"/>
                                    <TextBlock Text="Home" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnTemas" Style="{StaticResource MenuButtonStyle}" Click="BtnTemas_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M17.5,8A1.5,1.5 0 1,1 16,9.5A1.5,1.5 0 0,1 17.5,8 M12.5,5A1.5,1.5 0 1,1 11,6.5A1.5,1.5 0 0,1 12.5,5 M7.5,8A1.5,1.5 0 1,1 6,9.5A1.5,1.5 0 0,1 7.5,8 M7.5,14A1.5,1.5 0 1,1 6,15.5A1.5,1.5 0 0,1 7.5,14 M12.083 24A12 12 0 0 1 3.745 3.371 11.885 11.885 0 0 1 12.5.007 12.155 12.155 0 0 1 24.08 11.7a11.924 11.924 0 0 1-.775 4.552 1.888 1.888 0 0 1-1.377 1.177 1.912 1.912 0 0 1-1.769-.521l-.1-.1a3.567 3.567 0 0 0-6.089 2.553l.04 4.516-.924.077C12.753 23.978 12.421 24 12.083 24Zm0-22a10 10 0 0 0-.09 20l-.024-2.625A5.6 5.6 0 0 1 13.6 15.39h0a5.57 5.57 0 0 1 7.872 0l.014.014a9.892 9.892 0 0 0 .595-3.655 10.127 10.127 0 0 0-9.645-9.743C12.317 2 12.2 2 12.082 2Z" 
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                          Stretch="Uniform" Width="20" Height="20" Margin="0,0,15,0"/>
                                    <TextBlock Text="Temas OPL" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnJuegos" Style="{StaticResource MenuButtonStyle}" Click="BtnJuegos_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12.006 3.212C6.888 3.212 1.155 4.343 1 12.323c.047 2.322 .562 5.382 1.607 6.983 .667 1.021 1.849 1.567 3.089 1.426 1.23-.14 2.254-.932 2.671-2.067 .6-1.639 1.757-2.41 3.625-2.424 1.845 .015 3.036 .823 3.643 2.472 .415 1.126 1.57 2.077 3.041 2.077 1.09 0 2.099-.53 2.696-1.438 1.06-1.607 1.581-4.688 1.628-7.067-.152-7.984-6.09-9.072-10.994-9.072Zm7.696 15.039c-.256 .387-.702 .585-1.186 .529-.475-.055-.85-.338-1.005-.759-.89-2.417-2.844-3.759-5.52-3.781-2.713 .021-4.616 1.313-5.503 3.736-.157 .426-.538 .713-1.02 .769-.486 .053-.934-.144-1.188-.532-.695-1.065-1.234-3.559-1.282-5.89 .114-5.877 3.528-7.079 9-7.11 6.38 .039 8.903 2.033 9 7.071-.048 2.39-.594 4.899-1.298 5.968Z M9.431 10.989l-.495-.495 .495-.495c.39-.39 .391-1.023 0-1.414s-1.024-.39-1.414 0l-.495 .495-.495-.495c-.391-.391-1.024-.39-1.414 0s-.391 1.023 0 1.414l.495 .495-.495 .495c-.39 .39-.391 1.023 0 1.414s1.024 .39 1.414 0l.495-.495 .495 .495c.391 .391 1.024 .39 1.414 0s.391-1.023 0-1.414Z M15.3,8.6 a1,1 0 1,1 2,0 a1,1 0 1,1 -2,0 M17.2,10.5 a1,1 0 1,1 2,0 a1,1 0 1,1 -2,0 M15.3,12.4 a1,1 0 1,1 2,0 a1,1 0 1,1 -2,0 M13.4,10.5 a1,1 0 1,1 2,0 a1,1 0 1,1 -2,0" 
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                          Stretch="Uniform" Width="22" Height="22" Margin="0,0,15,0"/>
                                    <TextBlock Text="Juegos" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnCrear" Style="{StaticResource MenuButtonStyle}" Click="BtnCrear_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" 
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                          Stretch="Uniform" Width="20" Height="20" Margin="0,0,15,0"/>
                                    <TextBlock Text="Crear" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnHerramientas" Style="{StaticResource MenuButtonStyle}" Click="BtnHerramientas_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                          Stretch="Uniform" Width="20" Height="20" Margin="0,0,15,0"/>
                                    <TextBlock Text="Herramientas" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnLibreria" Style="{StaticResource MenuButtonStyle}" Click="BtnLibreria_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z"
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                          Stretch="Uniform" Width="20" Height="20" Margin="0,0,15,0"/>
                                    <TextBlock Text="Librería" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnConfig" Style="{StaticResource MenuButtonStyle}" Click="BtnConfig_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" 
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                          Stretch="Uniform" Width="20" Height="20" Margin="0,0,15,0"/>
                                    <TextBlock Text="Config" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnAdmin" Style="{StaticResource MenuButtonStyle}" Click="BtnAdmin_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                          Stretch="Uniform" Width="20" Height="20" Margin="0,0,15,0"/>
                                    <TextBlock Text="Admin" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnPerfil" Style="{StaticResource MenuButtonStyle}" Click="BtnPerfil_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" 
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                          Stretch="Uniform" Width="20" Height="20" Margin="0,0,15,0"/>
                                    <TextBlock Text="Perfil" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border x:Name="ProfileSection" VerticalAlignment="Bottom" Margin="16,0,16,16" Cursor="Hand"
                                Background="Transparent" CornerRadius="12" Padding="8,8" MouseDown="ProfileSection_MouseDown">
                            <StackPanel>
                                <Border x:Name="AvatarBorder" Width="44" Height="44" Background="#2A2F42" CornerRadius="22" HorizontalAlignment="Left">
                                    <Border.Clip>
                                        <EllipseGeometry RadiusX="22" RadiusY="22" Center="22,22"/>
                                    </Border.Clip>
                                    <Image x:Name="AvatarImage" Stretch="UniformToFill" Width="44" Height="44"/>
                                </Border>
                                <TextBlock x:Name="ProfileName" Text="Usuario" Foreground="White" Margin="0,6,0,0" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:Name="LogoutText" Text="Cerrar sesión" Foreground="#888E9E"
                                           FontSize="11" Cursor="Hand" Margin="0,6,0,0" Visibility="Collapsed"
                                           MouseDown="LogoutText_MouseDown" MouseEnter="LogoutText_MouseEnter"
                                           MouseLeave="LogoutText_MouseLeave"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="0,60,0,0" ClipToBounds="True">
                    <ContentControl x:Name="MainContentFrame">
                        <vistas:LoginView />
                    </ContentControl>
                </Grid>
            </Grid>

            <!-- Header después del layout para que tenga el Z-order más alto -->
            <Grid Height="60" VerticalAlignment="Top" Margin="220,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Button Content="‹" Foreground="White" FontSize="20" Background="Transparent" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                    <Button Content="›" Foreground="#555" FontSize="20" Background="Transparent" BorderThickness="0" Margin="0,0,20,0"/>

                    <Border Background="#1C2030" CornerRadius="15" Width="300" Height="35">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Margin="12,0">
                                <Path Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                      Fill="#888E9E" Stretch="Uniform" Width="15" Margin="0,0,10,0"/>
                                <TextBlock Text="Buscar en la tienda" Foreground="#888E9E" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,25,0">
                    <Button Style="{StaticResource MinButtonStyle}" Margin="0,0,10,0" Click="BtnMinimize_Click"/>
                    <Button Style="{StaticResource MaxButtonStyle}" Margin="0,0,10,0" Click="BtnMaximize_Click"/>
                    <Button Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- Toast notifications overlay -->
            <ItemsControl x:Name="ToastContainer" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                          Margin="0,0,20,20" IsHitTestVisible="False" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Background="{Binding Background}" Padding="14,10" Margin="0,0,0,8"
                                Opacity="{Binding Opacity}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" Foreground="{Binding Foreground}" FontSize="14" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Message}" Foreground="{Binding Foreground}" FontSize="13" TextWrapping="Wrap" MaxWidth="350"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>