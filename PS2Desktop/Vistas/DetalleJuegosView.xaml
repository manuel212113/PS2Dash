<UserControl x:Class="PS2Desktop.Vistas.DetalleJuegosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1200"
             Opacity="0"
             Background="#0A0A10">

    <UserControl.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#44000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="25" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8800ADFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThumbButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Viewbox x:Key="IconPause" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Fill="White" Data="M19 0H5C2.243 0 0 2.243 0 5v14c0 2.757 2.243 5 5 5h14c2.757 0 5-2.243 5-5V5c0-2.757-2.243-5-5-5Zm3 19c0 1.654-1.346 3-3 3H5c-1.654 0-3-1.346-3-3V5c0-1.654 1.346-3 3-3h14c1.654 0 3 1.346 3 3v14Zm-7-11v8c0 .553-.447 1-1 1s-1-.447-1-1V8c0-.552 .447-1 1-1s1 .448 1 1Zm-4 0v8c0 .553-.448 1-1 1s-1-.447-1-1V8c0-.552 .448-1 1-1s1 .448 1 1Z"/>
            </Canvas>
        </Viewbox>
        <Viewbox x:Key="IconPlay" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Fill="White" Data="m19 24h-14a5.006 5.006 0 0 1 -5-5v-14a5.006 5.006 0 0 1 5-5h14a5.006 5.006 0 0 1 5 5v14a5.006 5.006 0 0 1 -5 5zm-14-22a3 3 0 0 0 -3 3v14a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-14a3 3 0 0 0 -3-3zm4.342 15.005a2.368 2.368 0 0 1 -1.186-.323 2.313 2.313 0 0 1 -1.164-2.021v-5.322a2.337 2.337 0 0 1 3.5-2.029l5.278 2.635a2.336 2.336 0 0 1 .049 4.084l-5.376 2.687a2.2 2.2 0 0 1 -1.101.289zm-.025-8a.314.314 0 0 0 -.157.042.327.327 0 0 0 -.168.292v5.322a.337.337 0 0 0 .5.293l5.376-2.688a.314.314 0 0 0 .12-.266.325.325 0 0 0 -.169-.292l-5.274-2.635a.462.462 0 0 0 -.228-.068z"/>
            </Canvas>
        </Viewbox>
        <Viewbox x:Key="IconVolOn" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Fill="White" Data="M20.807 4.29a1 1 0 0 0-1.415 1.415 8.913 8.913 0 0 1 0 12.59 1 1 0 0 0 1.415 1.415A10.916 10.916 0 0 0 20.807 4.29Z"/>
                <Path Fill="White" Data="M18.1 7.291A1 1 0 0 0 16.68 8.706a4.662 4.662 0 0 1 0 6.588A1 1 0 0 0 18.1 16.709 6.666 6.666 0 0 0 18.1 7.291Z"/>
                <Path Fill="White" Data="M13.82.2A12.054 12.054 0 0 0 6.266 5H5a5.008 5.008 0 0 0-5 5v4a5.008 5.008 0 0 0 5 5H6.266A12.059 12.059 0 0 0 13.82 23.8a.917.917 0 0 0 .181.017 1 1 0 0 0 1-1V1.186A1 1 0 0 0 13.82.2ZM13 21.535a10.083 10.083 0 0 1-5.371-4.08A1 1 0 0 0 6.792 17H5a3 3 0 0 1-3-3V10A3 3 0 0 1 5 7h1.8a1 1 0 0 0 .837-.453A10.079 10.079 0 0 1 13 2.465Z"/>
            </Canvas>
        </Viewbox>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="TrackBackground" Height="4" Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#00ADFF" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" Focusable="True"
                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                  PreviewKeyDown="MainScrollViewer_PreviewKeyDown">
        <Grid Margin="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title row -->
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                <TextBlock x:Name="lblTitle" Text="Cargando..." Foreground="White" FontSize="42" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="lblDeveloper" Foreground="#AAA" FontSize="14"/>
                    <TextBlock x:Name="lblPublisher" Foreground="#888" FontSize="14" Margin="12,0,0,0"/>
                    <TextBlock x:Name="lblYear" Foreground="#666" FontSize="14" Margin="12,0,0,0"/>
                    <Border Background="#0055CC" Padding="6,2" CornerRadius="4" Margin="12,0,0,0">
                        <TextBlock x:Name="lblGameId" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#1A2238" Padding="6,2" CornerRadius="4" Margin="6,0,0,0">
                        <TextBlock x:Name="lblRegion" Foreground="#888" FontSize="12"/>
                    </Border>
                    <Border Background="#1A2238" Padding="6,2" CornerRadius="4" Margin="6,0,0,0">
                        <TextBlock x:Name="lblMediaType" Foreground="#888" FontSize="12"/>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="RatingPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="lblStars" Foreground="White" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock x:Name="lblRatingValue" Foreground="#00ADFF" FontSize="14" FontWeight="Bold" Margin="8,0,20,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblRatingCount" Foreground="#AAA" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Left column -->
            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cover + Video area -->
                <StackPanel Grid.Row="0">
                    <Border x:Name="PlayerBorder" CornerRadius="20,20,0,0" Background="Black"
                            ClipToBounds="True" Height="480"
                            MouseEnter="PlayerBorder_MouseEnter"
                            MouseMove="PlayerBorder_MouseMove"
                            MouseLeave="PlayerBorder_MouseLeave">
                        <Grid Background="Black">
                            <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                            <vlc:VideoView x:Name="VideoPlayer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                           Visibility="Collapsed" Background="Black" IsHitTestVisible="False"/>

                            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <ProgressBar IsIndeterminate="True" Width="100" Height="4"
                                             Foreground="#00ADFF" Background="Transparent" BorderThickness="0"/>
                                <TextBlock Text="Cargando..." Foreground="White" Margin="0,15,0,0"
                                           HorizontalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>

                            <Canvas>
                                <Button x:Name="btnPrev" Content="❮" Style="{StaticResource NavButtonStyle}"
                                        Canvas.Left="20" Canvas.Top="200" Click="btnPrev_Click"/>
                                <Button x:Name="btnNext" Content="❯" Style="{StaticResource NavButtonStyle}"
                                        Canvas.Right="20" Canvas.Top="200" Click="btnNext_Click"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <Border x:Name="ControlsPanel" CornerRadius="0,0,20,20" Background="#1C2030"
                            Padding="12,12" Height="68"
                            MouseEnter="ControlsPanel_MouseEnter"
                            MouseMove="ControlsPanel_MouseMove">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Slider x:Name="TimelineSlider" Style="{StaticResource ModernSlider}" Maximum="100"
                                    Thumb.DragStarted="TimelineSlider_DragStarted"
                                    Thumb.DragCompleted="TimelineSlider_DragCompleted"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="btnPlayPause" Content="{StaticResource IconPlay}"
                                        Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                        Click="btnPlayPause_Click" Foreground="White"/>
                                <Button x:Name="btnMute" Content="{StaticResource IconVolOn}"
                                        Width="22" Height="28" Background="Transparent" BorderThickness="0"
                                        Margin="10,0" Click="btnMute_Click" Foreground="White"/>
                                <TextBlock x:Name="lblTime" Text="0:00" Foreground="White"
                                           VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text=" / " Foreground="Gray" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock x:Name="lblTotalTime" Text="0:00" Foreground="Gray"
                                           VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Background thumbnails grid -->
                <UniformGrid x:Name="ThumbnailsGrid" Grid.Row="1" Columns="4" Margin="0,20,0,0">
                    <Button x:Name="ThumbBtn0" Style="{StaticResource ThumbButtonStyle}" Click="SeleccionarMedia_Click" Tag="bg0">
                        <Border x:Name="BorderThumb0" Height="100" CornerRadius="10" BorderThickness="2"
                                BorderBrush="#00ADFF" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="ThumbImg0" Stretch="UniformToFill"/>
                                <Viewbox Width="24" Height="24" Visibility="{Binding ElementName=ThumbImg0, Path=Opacity, Converter={x:Null}}">
                                    <Path Fill="White" Data="M8,5.14V19.14L19,12.14L8,5.14Z" Visibility="Collapsed"/>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Button>
                    <Button x:Name="ThumbBtn1" Style="{StaticResource ThumbButtonStyle}" Click="SeleccionarMedia_Click" Tag="bg1">
                        <Border x:Name="BorderThumb1" Height="100" CornerRadius="10" BorderThickness="0"
                                BorderBrush="#00ADFF" ClipToBounds="True">
                            <Image x:Name="ThumbImg1" Stretch="UniformToFill"/>
                        </Border>
                    </Button>
                    <Button x:Name="ThumbBtn2" Style="{StaticResource ThumbButtonStyle}" Click="SeleccionarMedia_Click" Tag="bg2">
                        <Border x:Name="BorderThumb2" Height="100" CornerRadius="10" BorderThickness="0"
                                BorderBrush="#00ADFF" ClipToBounds="True">
                            <Image x:Name="ThumbImg2" Stretch="UniformToFill"/>
                        </Border>
                    </Button>
                    <Button x:Name="ThumbBtn3" Style="{StaticResource ThumbButtonStyle}" Click="SeleccionarMedia_Click" Tag="bg3">
                        <Border x:Name="BorderThumb3" Height="100" CornerRadius="10" BorderThickness="0"
                                BorderBrush="#00ADFF" ClipToBounds="True">
                            <Image x:Name="ThumbImg3" Stretch="UniformToFill"/>
                        </Border>
                    </Button>
                </UniformGrid>
            </Grid>

            <!-- Right sidebar -->
            <StackPanel Grid.Row="1" Grid.Column="1">
                <!-- Cover poster -->
                <Border Background="#1C2030" CornerRadius="20" Padding="0" Margin="0,0,0,16" ClipToBounds="True"
                        Height="280">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1C2030"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#252A3A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Image x:Name="PosterImage" Stretch="UniformToFill"/>
                </Border>

                <!-- Info cards -->
                <Border Background="#1C2030" CornerRadius="20" Padding="20">
                    <StackPanel>
                        <TextBlock Text="GRATIS" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        <Button x:Name="btnDownload" Margin="0,16,0,0" Height="54"
                                Background="#0055CC" Foreground="White" FontWeight="Bold"
                                FontSize="14" Cursor="Hand" Click="btnDownload_Click"
                                BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#0055CC"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="12"
                                                        Background="{TemplateBinding Background}"
                                                        BorderThickness="0">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#0066DD"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#0044AA"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#2A2F42"/>
                                                        <Setter Property="Foreground" Value="#6B7280"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Separator Background="#33FFFFFF" Margin="0,20,0,16"/>

                        <TextBlock Text="Información" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <StackPanel x:Name="InfoRows">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Género" Foreground="#6B7280" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="lblGenero" Foreground="#AAA" FontSize="12"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Desarrollador" Foreground="#6B7280" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="lblDevDetail" Foreground="#AAA" FontSize="12"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Distribuidor" Foreground="#6B7280" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="lblPubDetail" Foreground="#AAA" FontSize="12"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Lanzamiento" Foreground="#6B7280" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="lblFechaDetail" Foreground="#AAA" FontSize="12"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Jugadores" Foreground="#6B7280" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="lblJugadores" Foreground="#AAA" FontSize="12"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Resolución" Foreground="#6B7280" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="lblResolucion" Foreground="#AAA" FontSize="12"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Widescreen" Foreground="#6B7280" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="lblWidescreen" Foreground="#AAA" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Bottom: description + rating -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,40,0,0">
                <Separator Background="#33FFFFFF" Margin="0,0,0,30"/>
                <TextBlock Text="Descripción" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
                <TextBlock x:Name="lblDescripcion" TextWrapping="Wrap" Foreground="#AAA" FontSize="16" LineHeight="24" />

                <TextBlock Text="Características" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,8"/>
                <ItemsControl x:Name="CaracteristicasList" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="•" Foreground="#00ADFF" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding}" Foreground="#AAA"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Valorar" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,8"/>
                <StackPanel x:Name="VotePanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="StarBtn1" Content="☆" Width="40" Height="40" FontSize="24" Margin="2"
                            Tag="1" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#888"/>
                    <Button x:Name="StarBtn2" Content="☆" Width="40" Height="40" FontSize="24" Margin="2"
                            Tag="2" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#888"/>
                    <Button x:Name="StarBtn3" Content="☆" Width="40" Height="40" FontSize="24" Margin="2"
                            Tag="3" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#888"/>
                    <Button x:Name="StarBtn4" Content="☆" Width="40" Height="40" FontSize="24" Margin="2"
                            Tag="4" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#888"/>
                    <Button x:Name="StarBtn5" Content="☆" Width="40" Height="40" FontSize="24" Margin="2"
                            Tag="5" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#888"/>
                    <TextBlock x:Name="txtRatingInfo" Text="" Foreground="#AAA" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
