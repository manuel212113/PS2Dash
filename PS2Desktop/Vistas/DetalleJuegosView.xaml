<UserControl x:Class="PS2Desktop.Vistas.DetalleJuegosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1200"
             Opacity="0"
             Background="#0A0A10">

    <UserControl.Resources>
        <Viewbox x:Key="IconPause" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Fill="White" Data="M19 0H5C2.243 0 0 2.243 0 5v14c0 2.757 2.243 5 5 5h14c2.757 0 5-2.243 5-5V5c0-2.757-2.243-5-5-5Zm3 19c0 1.654-1.346 3-3 3H5c-1.654 0-3-1.346-3-3V5c0-1.654 1.346-3 3-3h14c1.654 0 3 1.346 3 3v14Zm-7-11v8c0 .553-.447 1-1 1s-1-.447-1-1V8c0-.552 .447-1 1-1s1 .448 1 1Zm-4 0v8c0 .553-.448 1-1 1s-1-.447-1-1V8c0-.552 .448-1 1-1s1 .448 1 1Z"/>
            </Canvas>
        </Viewbox>
        <Viewbox x:Key="IconPlay" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Fill="White" Data="m19 24h-14a5.006 5.006 0 0 1 -5-5v-14a5.006 5.006 0 0 1 5-5h14a5.006 5.006 0 0 1 5 5v14a5.006 5.006 0 0 1 -5 5zm-14-22a3 3 0 0 0 -3 3v14a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-14a3 3 0 0 0 -3-3zm4.342 15.005a2.368 2.368 0 0 1 -1.186-.323 2.313 2.313 0 0 1 -1.164-2.021v-5.322a2.337 2.337 0 0 1 3.5-2.029l5.278 2.635a2.336 2.336 0 0 1 .049 4.084l-5.376 2.687a2.2 2.2 0 0 1 -1.101.289zm-.025-8a.314.314 0 0 0 -.157.042.327.327 0 0 0 -.168.292v5.322a.337.337 0 0 0 .5.293l5.376-2.688a.314.314 0 0 0 .12-.266.325.325 0 0 0 -.169-.292l-5.274-2.635a.462.462 0 0 0 -.228-.068z"/>
            </Canvas>
        </Viewbox>
        <Viewbox x:Key="IconVolOn" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Fill="White" Data="M20.807 4.29a1 1 0 0 0-1.415 1.415 8.913 8.913 0 0 1 0 12.59 1 1 0 0 0 1.415 1.415A10.916 10.916 0 0 0 20.807 4.29Z"/>
                <Path Fill="White" Data="M18.1 7.291A1 1 0 0 0 16.68 8.706a4.662 4.662 0 0 1 0 6.588A1 1 0 0 0 18.1 16.709 6.666 6.666 0 0 0 18.1 7.291Z"/>
                <Path Fill="White" Data="M13.82.2A12.054 12.054 0 0 0 6.266 5H5a5.008 5.008 0 0 0-5 5v4a5.008 5.008 0 0 0 5 5H6.266A12.059 12.059 0 0 0 13.82 23.8a.917.917 0 0 0 .181.017 1 1 0 0 0 1-1V1.186A1 1 0 0 0 13.82.2ZM13 21.535a10.083 10.083 0 0 1-5.371-4.08A1 1 0 0 0 6.792 17H5a3 3 0 0 1-3-3V10A3 3 0 0 1 5 7h1.8a1 1 0 0 0 .837-.453A10.079 10.079 0 0 1 13 2.465Z"/>
            </Canvas>
        </Viewbox>
        <Viewbox x:Key="IconVolOff" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Fill="White" Data="M13.82.2A12.054 12.054 0 0 0 6.266 5H5a5.008 5.008 0 0 0-5 5v4a5.008 5.008 0 0 0 5 5H6.266A12.059 12.059 0 0 0 13.82 23.8a.917.917 0 0 0 .181.017 1 1 0 0 0 1-1V1.186A1 1 0 0 0 13.82.2ZM13 21.535a10.083 10.083 0 0 1-5.371-4.08A1 1 0 0 0 6.792 17H5a3 3 0 0 1-3-3V10A3 3 0 0 1 5 7h1.8a1 1 0 0 0 .837-.453A10.079 10.079 0 0 1 13 2.465Z"/>
                <Line X1="19" Y1="5" X2="5" Y2="19" Stroke="White" StrokeThickness="2"/>
            </Canvas>
        </Viewbox>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="TrackBackground" Height="4" Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#00ADFF" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" Focusable="True"
                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                  PreviewKeyDown="MainScrollViewer_PreviewKeyDown">
        <Grid Margin="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title row -->
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                <Button x:Name="btnVolver" Content="&#x25C0; Volver" Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Left" Margin="0,0,0,8" Click="btnVolver_Click"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="GameIcoImage" Width="48" Height="48" Margin="0,0,14,0" 
                           RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                    <TextBlock x:Name="lblTitle" Text="Cargando..." Foreground="{DynamicResource TextMainBrush}" FontSize="42" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="lblDeveloper" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="14"/>
                    <TextBlock x:Name="lblPublisher" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="14" Margin="12,0,0,0"/>
                    <TextBlock x:Name="lblYear" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="12,0,0,0"/>
                    <Border Background="{DynamicResource AccentDarkBrush}" Padding="6,2" CornerRadius="4" Margin="12,0,0,0">
                        <TextBlock x:Name="lblGameId" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="{DynamicResource CardAltBrush}" Padding="6,2" CornerRadius="4" Margin="6,0,0,0">
                        <TextBlock x:Name="lblRegion" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="12"/>
                    </Border>
                    <Border Background="{DynamicResource CardAltBrush}" Padding="6,2" CornerRadius="4" Margin="6,0,0,0">
                        <TextBlock x:Name="lblMediaType" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="12"/>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="RatingPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="lblStars" Foreground="{DynamicResource TextMainBrush}" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock x:Name="lblRatingValue" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="Bold" Margin="8,0,20,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblRatingCount" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Left column -->
            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cover + Video area -->
                <StackPanel Grid.Row="0">
                    <Border x:Name="PlayerBorder" CornerRadius="20,20,0,0" Background="Black"
                            ClipToBounds="True" Height="480"
                            >
                        <Grid Background="Black">
                            <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                            <vlc:VideoView x:Name="VideoPlayer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                           Visibility="Collapsed" Background="Black" IsHitTestVisible="False"/>

                            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <ProgressBar IsIndeterminate="True" Width="100" Height="4"
                                             Foreground="#00ADFF" Background="Transparent" BorderThickness="0"/>
                                <TextBlock Text="Cargando..." Foreground="White" Margin="0,15,0,0"
                                           HorizontalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>

                            <Canvas>
                                <Button x:Name="btnPrev" Content="❮" Style="{StaticResource IconButtonStyle}"
                                        Width="50" Height="50" FontSize="24"
                                        Canvas.Left="20" Canvas.Top="200" Click="btnPrev_Click"/>
                                <Button x:Name="btnNext" Content="❯" Style="{StaticResource IconButtonStyle}"
                                        Width="50" Height="50" FontSize="24"
                                        Canvas.Right="20" Canvas.Top="200" Click="btnNext_Click"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <Border x:Name="ControlsPanel" CornerRadius="0,0,20,20" Background="{DynamicResource CardAltBrush}"
                            Padding="12,12" Height="68"
                            >
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Slider x:Name="TimelineSlider" Style="{StaticResource ModernSlider}" Maximum="100"
                                    Thumb.DragStarted="TimelineSlider_DragStarted"
                                    Thumb.DragCompleted="TimelineSlider_DragCompleted"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="btnPlayPause" Content="{StaticResource IconPlay}"
                                        Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                        Click="btnPlayPause_Click" Foreground="{DynamicResource TextMainBrush}"/>
                                <Button x:Name="btnMute" Content="{StaticResource IconVolOn}"
                                        Width="22" Height="28" Background="Transparent" BorderThickness="0"
                                        Margin="10,0,4,0" Click="btnMute_Click" Foreground="{DynamicResource TextMainBrush}"/>
                                <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="100" Value="100"
                                        VerticalAlignment="Center" Margin="0,0,10,0"
                                        Thumb.DragStarted="VolumeSlider_DragStarted"
                                        Thumb.DragCompleted="VolumeSlider_DragCompleted"
                                        ValueChanged="VolumeSlider_ValueChanged"/>
                                <TextBlock x:Name="lblTime" Text="0:00" Foreground="{DynamicResource TextMainBrush}"
                                           VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text=" / " Foreground="{DynamicResource TextSecundarioBrush}" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock x:Name="lblTotalTime" Text="0:00" Foreground="{DynamicResource TextSecundarioBrush}"
                                           VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Background thumbnails grid -->
                <UniformGrid x:Name="ThumbnailsGrid" Grid.Row="1" Columns="4" Margin="0,20,0,0">
                    <Button x:Name="ThumbBtn0" Style="{StaticResource ThumbButtonStyle}" Click="SeleccionarMedia_Click" Tag="bg0">
                        <Border x:Name="BorderThumb0" Height="100" CornerRadius="10" BorderThickness="2"
                                BorderBrush="#00ADFF" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="ThumbImg0" Stretch="UniformToFill"/>
                                <Viewbox Width="24" Height="24" Visibility="Collapsed">
                                    <Path Fill="White" Data="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Button>
                    <Button x:Name="ThumbBtn1" Style="{StaticResource ThumbButtonStyle}" Click="SeleccionarMedia_Click" Tag="bg1">
                        <Border x:Name="BorderThumb1" Height="100" CornerRadius="10" BorderThickness="0"
                                BorderBrush="#00ADFF" ClipToBounds="True">
                            <Image x:Name="ThumbImg1" Stretch="UniformToFill"/>
                        </Border>
                    </Button>
                    <Button x:Name="ThumbBtn2" Style="{StaticResource ThumbButtonStyle}" Click="SeleccionarMedia_Click" Tag="bg2">
                        <Border x:Name="BorderThumb2" Height="100" CornerRadius="10" BorderThickness="0"
                                BorderBrush="#00ADFF" ClipToBounds="True">
                            <Image x:Name="ThumbImg2" Stretch="UniformToFill"/>
                        </Border>
                    </Button>
                    <Button x:Name="ThumbBtn3" Style="{StaticResource ThumbButtonStyle}" Click="SeleccionarMedia_Click" Tag="bg3">
                        <Border x:Name="BorderThumb3" Height="100" CornerRadius="10" BorderThickness="0"
                                BorderBrush="#00ADFF" ClipToBounds="True">
                            <Image x:Name="ThumbImg3" Stretch="UniformToFill"/>
                        </Border>
                    </Button>
                </UniformGrid>
            </Grid>

            <!-- Right sidebar -->
            <StackPanel Grid.Row="1" Grid.Column="1">
                <!-- Cover poster -->
                <Border Background="{DynamicResource CardAltBrush}" CornerRadius="20" Padding="0" Margin="0,0,0,16" ClipToBounds="True"
                        Height="280">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardAltBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Image x:Name="PosterImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" ImageFailed="PosterImage_ImageFailed"/>
                </Border>

                <!-- Info cards -->
                <Border Background="{DynamicResource CardAltBrush}" CornerRadius="20" Padding="20">
                    <StackPanel>
                        <TextBlock Text="GRATIS" Foreground="{DynamicResource TextMainBrush}" FontSize="24" FontWeight="Bold"/>
                        <Button x:Name="btnDownload" Margin="0,16,0,0" Height="54"
                                Style="{StaticResource AccentButtonStyle}" Click="btnDownload_Click"
                                ToolTip="Descargar juego"/>

                        <Separator Background="#33FFFFFF" Margin="0,20,0,16"/>

                        <TextBlock Text="Información" Foreground="{DynamicResource TextMainBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <StackPanel x:Name="InfoRows">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Género" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="lblGenero" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="12"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Desarrollador" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="lblDevDetail" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="12"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Distribuidor" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="lblPubDetail" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="12"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Lanzamiento" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="lblFechaDetail" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="12"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Jugadores" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="lblJugadores" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="12"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Resolución" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="lblResolucion" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="12"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Widescreen" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="lblWidescreen" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Bottom: description + rating -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,40,0,0">
                <Separator Background="#33FFFFFF" Margin="0,0,0,30"/>
                <TextBlock Text="Descripción" Foreground="{DynamicResource TextMainBrush}" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
                <TextBlock x:Name="lblDescripcion" TextWrapping="Wrap" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="16" LineHeight="24" />

                <TextBlock Text="Características" Foreground="{DynamicResource TextMainBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,8"/>
                <ItemsControl x:Name="CaracteristicasList" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextSecundarioBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Valorar" Foreground="{DynamicResource TextMainBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,8"/>
                <StackPanel x:Name="VotePanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="StarBtn1" Content="☆" Style="{StaticResource StarButtonStyle}"
                            Tag="1" Foreground="{DynamicResource TextSecundarioBrush}" ToolTip="1 estrella"/>
                    <Button x:Name="StarBtn2" Content="☆" Style="{StaticResource StarButtonStyle}"
                            Tag="2" Foreground="{DynamicResource TextSecundarioBrush}" ToolTip="2 estrellas"/>
                    <Button x:Name="StarBtn3" Content="☆" Style="{StaticResource StarButtonStyle}"
                            Tag="3" Foreground="{DynamicResource TextSecundarioBrush}" ToolTip="3 estrellas"/>
                    <Button x:Name="StarBtn4" Content="☆" Style="{StaticResource StarButtonStyle}"
                            Tag="4" Foreground="{DynamicResource TextSecundarioBrush}" ToolTip="4 estrellas"/>
                    <Button x:Name="StarBtn5" Content="☆" Style="{StaticResource StarButtonStyle}"
                            Tag="5" Foreground="{DynamicResource TextSecundarioBrush}" ToolTip="5 estrellas"/>
                    <TextBlock x:Name="txtRatingInfo" Text="" Foreground="{DynamicResource TextSecundarioBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
