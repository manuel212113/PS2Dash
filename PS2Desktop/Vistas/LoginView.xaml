<UserControl x:Class="PS2Desktop.Vistas.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             FontFamily="{StaticResource GoogleSans}">

    <UserControl.Resources>
        <Style x:Key="InputField" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0A0A0A">
        <!-- Subtle radial glow -->
        <Ellipse Width="500" Height="500" Fill="#0055CC" Opacity="0.04"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Login card -->
        <Border Width="420" Padding="40,36"
                Background="#111318" CornerRadius="16"
                BorderThickness="1" BorderBrush="#1E2228"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>

                <!-- PS2 Dash logo -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="PS2" Foreground="White" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text=" Dash" Foreground="White" FontSize="20" FontWeight="SemiBold" Opacity="0.6"
                               VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>

                <!-- Welcome text -->
                <TextBlock Text="Qué bueno verte de nuevo" Foreground="White" FontSize="20" FontWeight="Bold"
                           Margin="0,0,0,28"/>

                <!-- Email field -->
                <TextBlock Text="Correo electrónico" Foreground="#6B7280" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border x:Name="EmailBorder" Background="#1A1A1A" CornerRadius="10" Height="48"
                        BorderThickness="1" BorderBrush="#2A2A2A">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="M4,2 L20,2 C21.1,2 22,2.9 22,4 L22,12 C22,13.1 21.1,14 20,14 L4,14 C2.9,14 2,13.1 2,12 L2,4 C2,2.9 2.9,2 4,2 Z M8,14 L16,14 L16,16 L8,16 Z M2,16 L22,16 L22,22 C22,23.1 21.1,24 20,24 L4,24 C2.9,24 2,23.1 2,22 Z"
                              Fill="#6B7280" Stretch="Uniform" Width="18" Height="18" Margin="0,0,10,0"
                              VerticalAlignment="Center"/>
                        <TextBox x:Name="txtEmail" Grid.Column="1"
                                 Background="Transparent" Foreground="White"
                                 BorderThickness="0" FontSize="13"
                                 VerticalContentAlignment="Center"
                                 Tag="usuario@ejemplo.com"
                                 GotFocus="Txt_GotFocus" LostFocus="Txt_LostFocus">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <TextBlock x:Name="Placeholder"
                                                               Text="{TemplateBinding Tag}"
                                                               Foreground="#5A5A5A" FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Visibility="Collapsed"/>
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Password field -->
                <TextBlock Text="Contraseña" Foreground="#6B7280" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <Border x:Name="PassBorder" Background="#1A1A1A" CornerRadius="10" Height="48"
                        BorderThickness="1" BorderBrush="#2A2A2A">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="M12,2 C7.5,2 4,5.5 4,10 L4,12 C2.9,12 2,12.9 2,14 L2,22 C2,23.1 2.9,24 4,24 L20,24 C21.1,24 22,23.1 22,22 L22,14 C22,12.9 21.1,12 20,12 L20,10 C20,5.5 16.5,2 12,2 Z M12,14 C13.1,14 14,14.9 14,16 C14,17.1 13.1,18 12,18 C10.9,18 10,17.1 10,16 C10,14.9 10.9,14 12,14 Z M6,10 C6,6.7 8.7,4 12,4 C15.3,4 18,6.7 18,10 L18,12 L6,12 Z"
                              Fill="#6B7280" Stretch="Uniform" Width="18" Height="18" Margin="0,0,10,0"
                              VerticalAlignment="Center"/>

                        <PasswordBox x:Name="txtPassword" Grid.Column="1"
                                      Background="Transparent" Foreground="White"
                                      BorderThickness="0" FontSize="13"
                                      VerticalContentAlignment="Center"
                                      GotFocus="Pass_GotFocus" LostFocus="Pass_LostFocus"/>

                        <TextBox x:Name="txtPasswordVisible" Grid.Column="1"
                                  Background="Transparent" Foreground="White"
                                  BorderThickness="0" FontSize="13"
                                  VerticalContentAlignment="Center" Visibility="Collapsed"/>

                        <Border Grid.Column="2" Width="28" Height="28" Cursor="Hand"
                                MouseDown="BtnTogglePassword_MouseDown">
                            <TextBlock x:Name="PasswordToggleIcon" Text="👁" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Remember & Forgot password -->
                <Grid Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand"
                                MouseDown="BtnRemember_MouseDown">
                        <Border x:Name="RememberCheck" Width="16" Height="16" CornerRadius="4"
                                Background="Transparent" BorderBrush="#0055CC" BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <Path x:Name="CheckMark" Data="M4,8 L7,11 L12,5" Stroke="#0055CC"
                                  StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                  Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
                        </Border>
                        <TextBlock Text="Recordar" Foreground="#6B7280" FontSize="12" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Button Content="¿Olvidaste tu contraseña?"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#0055CC" FontSize="12" Cursor="Hand"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="BtnForgotPassword_Click"/>
                </Grid>

                <!-- Sign in button -->
                <Border x:Name="btnSignIn" Background="#0055CC" CornerRadius="10" Height="48" Cursor="Hand"
                        Margin="0,22,0,0"
                        MouseDown="BtnSignIn_MouseDown"
                        MouseEnter="BtnSignIn_MouseEnter"
                        MouseLeave="BtnSignIn_MouseLeave">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M6,6 L18,6 M6,12 L18,12 M6,18 L18,18" Stroke="White" StrokeThickness="2.5"
                              StrokeEndLineCap="Round" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock x:Name="BtnSignInText" Text="Iniciar sesión" Foreground="White"
                                   FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Error status -->
                <TextBlock x:Name="LblStatus" Foreground="#FF4444" FontSize="12" Margin="0,12,0,0"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>

                <!-- Divider -->
                <Grid Margin="0,22,0,0">
                    <Separator Background="#2A2A2A" Height="1"/>
                </Grid>

                <!-- Google sign in -->
                <Border x:Name="btnGoogle" Background="#1A1A1A" CornerRadius="10" Height="44" Cursor="Hand"
                        Margin="0,16,0,0" BorderThickness="1" BorderBrush="#2A2A2A"
                        MouseDown="BtnGoogle_MouseDown"
                        MouseEnter="BtnGoogle_MouseEnter"
                        MouseLeave="BtnGoogle_MouseLeave">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="G" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock x:Name="BtnGoogleText" Text="o Inicia sesión con Google" Foreground="#9CA3AF" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Sign up link -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <TextBlock Text="¿No tienes cuenta?" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center"/>
                    <Button x:Name="btnSignUp" Content="Regístrate ahora"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#0055CC" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                            Padding="6,0" Click="BtnSignUp_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- PS2 controller button decoration (bottom-right) -->
        <Canvas Width="110" Height="70" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="0,0,24,20" Opacity="0.15" IsHitTestVisible="False">
            <Polygon Points="12,8 6,20 18,20" Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                     Canvas.Left="72" Canvas.Top="26"/>
            <Ellipse Width="14" Height="14" Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                     Canvas.Left="44" Canvas.Top="40"/>
            <Line X1="6" Y1="6" X2="18" Y2="18" Stroke="White" StrokeThickness="1.5" Canvas.Left="2" Canvas.Top="36"/>
            <Line X1="18" Y1="6" X2="6" Y2="18" Stroke="White" StrokeThickness="1.5" Canvas.Left="2" Canvas.Top="36"/>
            <Rectangle Width="14" Height="14" Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                       Canvas.Left="10" Canvas.Top="20"/>
        </Canvas>
    </Grid>
</UserControl>
