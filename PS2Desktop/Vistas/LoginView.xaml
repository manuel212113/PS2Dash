<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PS2Desktop.Vistas.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="820"
             FontFamily="Garamond">

    <UserControl.Resources>

        <!-- Input field style -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A1A2E"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <Grid>
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#AAAAAA"
                                           FontSize="13"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="14,0"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2EC4B6"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Password field style -->
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A1A2E"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="14,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2EC4B6"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary login button -->
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2EC4B6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A9E94"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Social icon button -->
        <Style x:Key="SocialButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2EC4B6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hyperlink-style button -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#2EC4B6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextDecorations="Underline"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- Dark outer background -->
    <Grid Background="#0B0B12">

        <!-- Centered card container -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="820" Height="480"
                CornerRadius="16"
                ClipToBounds="True">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Form panel -->
                <Border Grid.Column="0"
                        Background="White"
                        Padding="48,40">
                    <StackPanel VerticalAlignment="Center">

                        <!-- Title -->
                        <TextBlock Text="Bienvenido de vuelta"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#1A1A2E"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="Comida fresca entregada diariamente. Comienza gratis."
                                   FontSize="12"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,28"/>

                        <!-- Username field -->
                        <TextBox x:Name="txtEmail"
                                 Style="{StaticResource InputStyle}"
                                 Tag="Nombre de usuario"
                                 Margin="0,0,0,12"/>

                        <!-- Password field -->
                        <PasswordBox x:Name="txtPassword"
                                     Style="{StaticResource PasswordStyle}"
                                     Margin="0,0,0,8"/>

                        <!-- Forgot password -->
                        <Button Content="¿Olvidaste tu contraseña?"
                                Style="{StaticResource LinkButtonStyle}"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,20"
                                />

                        <!-- Login button -->
                        <Button x:Name="btnSignIn"
                                Content="Iniciar sesión"
                                Style="{StaticResource LoginButtonStyle}"
                                Margin="0,0,0,20"
                                Click="BtnSignIn_Click"/>

                        <!-- Divider -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Separator Grid.Column="0" Background="#E0E0E0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="o continúa con"
                                       FontSize="11"
                                       Foreground="#AAAAAA"
                                       Margin="10,0"/>
                            <Separator Grid.Column="2" Background="#E0E0E0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Social buttons -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,24">
                            <!-- Google -->
                            <Button Style="{StaticResource SocialButtonStyle}" Margin="0,0,10,0">
                                <TextBlock Text="G" Foreground="White" FontWeight="Bold" FontSize="16"/>
                            </Button>
                            <!-- Apple -->
                            <Button Style="{StaticResource SocialButtonStyle}" Margin="0,0,10,0">
                                <TextBlock Text="" Foreground="White" FontSize="16"/>
                            </Button>
                            <!-- Facebook -->
                            <Button Style="{StaticResource SocialButtonStyle}">
                                <TextBlock Text="f" Foreground="White" FontWeight="Bold" FontSize="16"/>
                            </Button>
                        </StackPanel>

                        <!-- Register link -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="¿No tienes cuenta? "
                                       FontSize="12"
                                       Foreground="#888888"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="btnSignUp"
                                    Content="Regístrate"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Click="BtnSignUp_Click"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- RIGHT: Decorative panel -->
                <Border Grid.Column="1" Background="#CBF5F0" ClipToBounds="True">

                    <!-- Decorative wavy lines background (SVG-style via Path) -->
                    <Grid>
                        <Canvas>
                            <!-- Subtle concentric arc decorations -->
                            <Ellipse Canvas.Left="160" Canvas.Top="-60"
                                     Width="400" Height="400"
                                     Stroke="#A8EDE6" StrokeThickness="1"
                                     Fill="Transparent"/>
                            <Ellipse Canvas.Left="120" Canvas.Top="-100"
                                     Width="480" Height="480"
                                     Stroke="#A8EDE6" StrokeThickness="0.8"
                                     Fill="Transparent"/>
                            <Ellipse Canvas.Left="80" Canvas.Top="-140"
                                     Width="560" Height="560"
                                     Stroke="#A8EDE6" StrokeThickness="0.6"
                                     Fill="Transparent"/>
                            <Ellipse Canvas.Left="40" Canvas.Top="-180"
                                     Width="640" Height="640"
                                     Stroke="#A8EDE6" StrokeThickness="0.5"
                                     Fill="Transparent"/>
                        </Canvas>

                        <!-- Illustration: figure holding heart -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="20">

                        

                            <!-- Pagination dots -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,16">
                                <Ellipse Width="6" Height="6" Fill="#A8EDE6" Margin="3,0"/>
                                <Ellipse Width="6" Height="6" Fill="#A8EDE6" Margin="3,0"/>
                                <Ellipse Width="6" Height="6" Fill="#A8EDE6" Margin="3,0"/>
                            </StackPanel>

                            <!-- Caption -->
                            <TextBlock TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="220"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="White">
                                <LineBreak/>directo a tu puerta, cada día.
                            </TextBlock>

                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
