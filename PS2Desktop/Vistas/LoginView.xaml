<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PS2Desktop.Vistas.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             FontFamily="Segoe UI"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>

        <!-- Input field style -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#888E9E"
                                           FontSize="13"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="14,0"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0078F2"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Password field style -->
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="14,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0078F2"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary login button -->
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0078F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#006CD9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Social icon button -->
        <Style x:Key="SocialButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#303030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hyperlink-style button -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#0078F2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextDecorations="Underline"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- Dark outer background -->
    <Grid Background="{StaticResource BackgroundBrush}">

        <!-- Centered form container -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">

            <!-- Title -->
            <TextBlock Text="Bienvenido"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <TextBlock Text="Inicia sesión para continuar"
                       FontSize="14"
                       Foreground="#888E9E"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,32"/>

            <!-- Email field -->
            <TextBlock Text="Email" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBox x:Name="txtEmail"
                     Style="{StaticResource InputStyle}"
                     Tag="tu@email.com"
                     Margin="0,0,0,20"/>

            <!-- Password field -->
            <TextBlock Text="Contraseña" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <PasswordBox x:Name="txtPassword"
                         Style="{StaticResource PasswordStyle}"
                         Margin="0,0,0,12"/>

            <!-- Forgot password -->
            <Button Content="¿Olvidaste tu contraseña?"
                    Style="{StaticResource LinkButtonStyle}"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,28"
                    Click="BtnForgotPassword_Click"/>

            <!-- Login button -->
            <Button x:Name="btnSignIn"
                    Content="Iniciar sesión"
                    Style="{StaticResource LoginButtonStyle}"
                    Margin="0,0,0,28"
                    Click="BtnSignIn_Click"/>

            <!-- Divider -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Separator Grid.Column="0" Background="#303030" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="o continúa con"
                           FontSize="11"
                           Foreground="#888E9E"
                           Margin="10,0"/>
                <Separator Grid.Column="2" Background="#303030" VerticalAlignment="Center"/>
            </Grid>

            <!-- Social buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,28">
                <!-- Google -->
                <Button Style="{StaticResource SocialButtonStyle}" Margin="0,0,12,0">
                    <TextBlock Text="G" Foreground="White" FontWeight="Bold" FontSize="16"/>
                </Button>
                <!-- Apple -->
                <Button Style="{StaticResource SocialButtonStyle}" Margin="0,0,12,0">
                    <TextBlock Text="󰀵" Foreground="White" FontSize="16"/>
                </Button>
                <!-- Facebook -->
                <Button Style="{StaticResource SocialButtonStyle}">
                    <TextBlock Text="f" Foreground="White" FontWeight="Bold" FontSize="16"/>
                </Button>
            </StackPanel>

            <!-- Register link -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="¿No tienes cuenta? "
                           FontSize="13"
                           Foreground="#888E9E"
                           VerticalAlignment="Center"/>
                <Button x:Name="btnSignUp"
                        Content="Regístrate"
                        Style="{StaticResource LinkButtonStyle}"
                        Padding="4,0"
                        Click="BtnSignUp_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
