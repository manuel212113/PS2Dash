<UserControl x:Class="PS2Desktop.Vistas.CrearView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="930"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8890A0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A2238"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A3A58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style x:Key="ToggleButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8890A0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderThickness="1" BorderBrush="#2A3A58">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0055CC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0055CC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A3A58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="True">
        <StackPanel Margin="40,30,40,40" MaxWidth="700">

            <!-- Header -->
            <TextBlock Text="Crear Nuevo" Foreground="White" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Añade un tema o juego a la base de datos" Foreground="#8890A0" FontSize="14" Margin="0,4,0,0"/>

            <!-- Toggle Tema / Juego -->
            <StackPanel Orientation="Horizontal" Margin="0,25,0,0">
                <RadioButton x:Name="RBTema" Content="Tema OPL" Style="{StaticResource ToggleButtonStyle}"
                             Checked="OnModeChanged"/>
                <RadioButton x:Name="RBJuego" Content="Juego" Style="{StaticResource ToggleButtonStyle}" Margin="12,0,0,0"
                             Checked="OnModeChanged"/>
            </StackPanel>

            <!-- Nombre -->
            <TextBlock Text="Nombre" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,0"/>
            <TextBox x:Name="TxtNombre" Style="{StaticResource FieldInputStyle}"/>

            <!-- Autor -->
            <TextBlock Text="Autor" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0"/>
            <TextBox x:Name="TxtAutor" Style="{StaticResource FieldInputStyle}"/>

            <!-- Descripción -->
            <TextBlock Text="Descripción" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0"/>
            <TextBox x:Name="TxtDescripcion" Style="{StaticResource FieldInputStyle}" Height="100"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <!-- Características -->
            <TextBlock Text="Características" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtCaracteristica" Grid.Column="0" Style="{StaticResource FieldInputStyle}"
                         Text="Escribe y presiona Agregar"/>
                <Button Grid.Column="1" Content="Agregar" Margin="8,0,0,0" Width="90"
                        Style="{StaticResource AccentButtonStyle}" Click="AddCaracteristica_Click"
                         Height="40"/>
            </Grid>
            <ItemsControl x:Name="CaracteristicasList" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2A3A58" CornerRadius="6" Padding="10,4" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}" Foreground="White" FontSize="12"/>
                                <TextBlock Text="✕" Foreground="#8890A0" FontSize="11" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Image URL -->
            <TextBlock Text="URL de imagen" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0"/>
            <TextBox x:Name="TxtImageUrl" Style="{StaticResource FieldInputStyle}"
                     TextChanged="OnImageUrlChanged"/>

            <!-- Image preview -->
            <Border x:Name="PreviewBorder" CornerRadius="8" Background="#0D1128" Height="180" Margin="0,10,0,0"
                    ClipToBounds="True" BorderThickness="1" BorderBrush="#2A3A58">
                <Image x:Name="PreviewImage" Stretch="Uniform" Width="320"/>
            </Border>

            <!-- Video URL -->
            <TextBlock Text="URL de video (opcional)" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0"/>
            <TextBox x:Name="TxtVideoUrl" Style="{StaticResource FieldInputStyle}"
                     Text="https://www.youtube.com/watch?v=..."/>

            <!-- Link de descarga -->
            <TextBlock Text="Link de descarga" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0"/>
            <TextBox x:Name="TxtLinkDescarga" Style="{StaticResource FieldInputStyle}"/>

            <!-- Submit -->
            <Button x:Name="BtnCrear" Content="CREAR" Margin="0,30,0,0" Height="48"
                    Style="{StaticResource AccentButtonStyle}" FontSize="16" FontWeight="Bold"
                    Click="BtnCrear_Click"/>
            <TextBlock Text="O pega el JSON aquí" Foreground="#8890A0" FontSize="12" Margin="0,24,0,6"/>
            <TextBox x:Name="TxtJsonImport" Style="{StaticResource FieldInputStyle}" Height="160"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"/>
            <Button x:Name="BtnImportar" Content="IMPORTAR JSON" Margin="0,8,0,0" Height="36"
                    Style="{StaticResource AccentButtonStyle}" Background="#2A3A58"
                    Click="BtnImportar_Click"/>
            <TextBlock x:Name="LblStatus" Foreground="#00E676" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center"/>

            <!-- ==================== ELIMINAR ==================== -->
            <Separator Margin="0,30,0,0" Background="#2A3A58" Height="1"/>
            <TextBlock Text="Eliminar Temas / Juegos" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,20,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="BtnLoadItems" Content="Cargar lista" Height="36" Width="140"
                        Style="{StaticResource AccentButtonStyle}" Background="#2A3A58"
                        Click="BtnLoadItems_Click"/>
                <TextBlock x:Name="LblItemCount" Text="0 elementos" Foreground="#8890A0" FontSize="13"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400" Margin="0,10,0,0">
                <ItemsControl x:Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#131A30" CornerRadius="10" Padding="14,10" Margin="0,0,0,6"
                                    BorderThickness="1" BorderBrush="#2A3A58">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="#1A2238" ClipToBounds="True">
                                        <Image Source="{Binding ImageUrl}" Stretch="Uniform" Width="48" Height="48"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0">
                                        <TextBlock Text="{Binding Nombre}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Tipo}" Foreground="#8890A0" FontSize="11"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="ELIMINAR" Width="80" Height="30"
                                            Style="{StaticResource DangerButtonStyle}" FontSize="11"
                                            CommandParameter="{Binding Id}" Click="BtnEliminarItem_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ==================== IMPORTAR AVATARES ==================== -->
            <Separator Margin="0,30,0,0" Background="#2A3A58" Height="1"/>
            <TextBlock Text="Importar Avatares" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,20,0,0"/>
            <TextBlock Text="Pega el JSON de avatares aquí" Foreground="#8890A0" FontSize="12" Margin="0,10,0,6"/>
            <TextBox x:Name="TxtAvatarJson" Style="{StaticResource FieldInputStyle}" Height="120"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"/>
            <Button x:Name="BtnImportarAvatares" Content="IMPORTAR AVATARES" Margin="0,8,0,0" Height="36"
                    Style="{StaticResource AccentButtonStyle}" Background="#2A3A58"
                    Click="BtnImportarAvatares_Click"/>
            <TextBlock x:Name="LblAvatarStatus" Foreground="#00E676" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center"/>

            <!-- Bottom spacer -->
            <Rectangle Height="40" Fill="Transparent"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
