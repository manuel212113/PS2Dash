<UserControl x:Class="PS2Desktop.Vistas.LibreriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="920" d:DesignWidth="1020"
             Background="#121212">

    <UserControl.Resources>
        <!-- OrbitOPL color tokens -->
        <Color x:Key="NavyDarkColor">#FF161929</Color>
        <Color x:Key="NavyBaseColor">#FF1E2136</Color>
        <Color x:Key="NavyLightColor">#FF252A3E</Color>
        <Color x:Key="PurplePrimaryColor">#FF5B3FBF</Color>
        <Color x:Key="CyanAccentColor">#FF1ABFDB</Color>
        <Color x:Key="TextMainColor">#FFE8E9F0</Color>
        <Color x:Key="TextMutedColor">#FFB8BAC5</Color>
        <Color x:Key="TextDimColor">#FF6B6F80</Color>
        <Color x:Key="BorderSubtleColor">#FF2A2F42</Color>

        <SolidColorBrush x:Key="NavyDarkBrush" Color="{StaticResource NavyDarkColor}"/>
        <SolidColorBrush x:Key="NavyBaseBrush" Color="{StaticResource NavyBaseColor}"/>
        <SolidColorBrush x:Key="NavyLightBrush" Color="{StaticResource NavyLightColor}"/>
        <SolidColorBrush x:Key="PurplePrimaryBrush" Color="{StaticResource PurplePrimaryColor}"/>
        <SolidColorBrush x:Key="CyanAccentBrush" Color="{StaticResource CyanAccentColor}"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMainColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>

        <!-- Glass panel -->
        <Style x:Key="ToolCard" TargetType="Border">
            <Setter Property="Background" Value="#B81E2136"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#244D5280"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- OrbitOPL primary button -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PurplePrimaryBrush}"/>
            <Setter Property="Foreground" Value="#FFF8F9FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DD6B4FCC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF4B2FAF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BorderSubtleBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF8B2020"/>
            <Setter Property="Foreground" Value="#FFF8F9FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFA32828"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF701818"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BorderSubtleBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A5B3FBF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#20242A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MediumButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource NavyLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF2E3348"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BorderSubtleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FF1A1D2A"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgressTrack" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Height" Value="8"/>
        </Style>

        <Style x:Key="ProgressFill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PurplePrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Width" Value="0"/>
        </Style>

        <DataTemplate x:Key="LibGamePosterTemplate">
            <Border x:Name="PosterTile" CornerRadius="8" ClipToBounds="True" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="BorderBrush" Value="#5e009b"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#5e009b"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="280"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" ClipToBounds="True" Background="#1A1D2E">
                        <Grid>
                            <Image x:Name="CoverImg" Source="{Binding CoverPath}" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CoverPath}" Value="">
                                                <Setter Property="Opacity" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"
                                      Fill="#484F58" Stretch="Uniform" Width="36" Height="36"/>
                            </StackPanel>
                            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="100">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#EE0C0E1A" Offset="0"/>
                                        <GradientStop Color="#B00C0E1A" Offset="0.45"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0"
                                    CornerRadius="4" Padding="6,2" Background="#5e009b" Opacity="0.9">
                                <TextBlock Text="{Binding System}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="8,6,8,8">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#C9D1D9" TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Background="#1A3A8AF0" CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                <TextBlock Text="{Binding GameId}" FontSize="9" Foreground="#3A8AF0" FontWeight="SemiBold" FontFamily="Consolas"/>
                            </Border>
                            <Border Background="#1A1ABFDB" CornerRadius="3" Padding="5,1">
                                <TextBlock Text="{Binding Format}" FontSize="9" Foreground="#1ABFDB" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SizeDisplay}" FontSize="9" Foreground="#8B949E" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="30,24,30,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Title + System Tabs + Search + Sort -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                <TextBlock Text="Librería" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock Text="Juegos montados" Foreground="#8B949E" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" x:Name="LibSystemTabsPanel" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="24,0,0,4"/>
            <!-- Search -->
            <Border Grid.Column="2" Background="#121212" CornerRadius="8" Height="36" Width="240"
                    BorderBrush="#373E47" BorderThickness="1" VerticalAlignment="Bottom" Margin="16,0,0,4">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                          Fill="#8B949E" Stretch="Uniform" Width="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtLibSearch" Grid.Column="1" Text="Buscar juegos..."
                             Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                             FontSize="13" Foreground="#8B949E" CaretBrush="#5e009b"
                             GotFocus="TxtLibSearch_GotFocus" LostFocus="TxtLibSearch_LostFocus"
                             TextChanged="TxtLibSearch_TextChanged"/>
                </Grid>
            </Border>
            <!-- Sort -->
            <ComboBox x:Name="CboLibSort" Grid.Column="3" Margin="12,0,0,0" Width="150" Height="36"
                      Style="{StaticResource DarkComboBoxStyle}" VerticalAlignment="Bottom" SelectionChanged="CboLibSort_SelectionChanged">
                <ComboBoxItem Content="Nombre A-Z" Tag="name_asc" IsSelected="True"/>
                <ComboBoxItem Content="Nombre Z-A" Tag="name_desc"/>
                <ComboBoxItem Content="Game ID" Tag="id_asc"/>
                <ComboBoxItem Content="Tamaño" Tag="size_desc"/>
                <ComboBoxItem Content="Reciente" Tag="date_desc"/>
            </ComboBox>
        </Grid>

        <!-- Row 1: Mount State -->
        <Border Grid.Row="1" Style="{StaticResource ToolCard}">
            <Grid>
                <!-- Empty State: No directory mounted -->
                <StackPanel x:Name="LibEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,24">
                    <!-- Glow circle -->
                    <Border HorizontalAlignment="Center" Width="88" Height="88" CornerRadius="44" Margin="0,0,0,20">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#331ABFDB" Offset="0.7"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <Border Width="64" Height="64" CornerRadius="32" Background="#1C2128" BorderBrush="#331ABFDB" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                  Fill="#1ABFDB" Stretch="Uniform" Width="32" Height="32"/>
                        </Border>
                    </Border>
                    <TextBlock Text="Sin directorio montado" Foreground="White" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Monta tu unidad o carpeta OPL para explorar y gestionar&#x0a;tu colección de juegos de PlayStation."
                               Foreground="#94A3B8" FontSize="14" TextAlignment="Center" LineHeight="22"
                               MaxWidth="400" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Button Style="{StaticResource AccentButtonStyle}" Height="40" Width="220"
                            FontSize="14" HorizontalAlignment="Center" Click="BtnLibSelectRoot_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                  Fill="White" Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Montar directorio" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Mounted State: path + buttons (hidden by default) -->
                <StackPanel x:Name="LibMountedState" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                          Fill="#1ABFDB" Stretch="Uniform" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblLibRootPath" Text="" Foreground="#C9D1D9" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" MaxWidth="500" TextTrimming="CharacterEllipsis"/>
                    <Button Content="Cambiar" Style="{StaticResource GhostButtonStyle}" Height="34" Width="90" FontSize="12"
                            Margin="16,0,0,0" Click="BtnLibSelectRoot_Click"/>
                    <Button Content="Escanear" Style="{StaticResource AccentButtonStyle}" Height="34" Width="100" FontSize="12"
                            Margin="8,0,0,0" Click="BtnLibScan_Click" x:Name="BtnLibScan"/>
                    <Button Content="Desmontar" Style="{StaticResource DangerButtonStyle}" Height="34" Width="100" FontSize="12"
                            Margin="8,0,0,0" Click="BtnLibUnmount_Click"/>
                    <Button Content="Descargar logos" Style="{StaticResource AccentButtonStyle}" Height="34" Width="120" FontSize="12"
                            Margin="8,0,0,0" Click="BtnLibDownloadAllLogos_Click"/>
                    <TextBlock x:Name="TxtLibGameCount" Text="0 juegos" Foreground="#8B949E" FontSize="13"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: Game Grid (scrollable cards only) -->
        <Grid x:Name="LibGridContainer" Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="LibGamesScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True">
                <ListBox x:Name="LibGamesListBox" Background="Transparent" BorderThickness="0"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False" MouseDoubleClick="LibGamesListBox_MouseDoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" Margin="8,8,8,8"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="2"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"
                                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#731ABFDB"/>
                                                <Setter TargetName="Bd" Property="Background" Value="#0C1ABFDB"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#AA5B3FBF"/>
                                                <Setter TargetName="Bd" Property="Background" Value="#1A5B3FBF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </ScrollViewer>

            <!-- Skeleton Loading -->
            <UniformGrid x:Name="LibSkeletonPanel" Grid.Row="0" Columns="5" Margin="8,8,8,8" Visibility="Collapsed">
                <Border Margin="4" Style="{StaticResource SkeletonRect}" CornerRadius="10"/>
                <Border Margin="4" Style="{StaticResource SkeletonRect}" CornerRadius="10"/>
                <Border Margin="4" Style="{StaticResource SkeletonRect}" CornerRadius="10"/>
                <Border Margin="4" Style="{StaticResource SkeletonRect}" CornerRadius="10"/>
                <Border Margin="4" Style="{StaticResource SkeletonRect}" CornerRadius="10"/>
            </UniformGrid>

            <!-- Pagination -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4">
                <Button x:Name="BtnLibPrevPage" Content="&#x25C0;" Style="{StaticResource PaginationButtonStyle}" FontSize="18" Click="BtnLibPrevPage_Click"/>
                <TextBlock x:Name="TxtLibPageInfo" Text="1" Foreground="#C9D1D9" VerticalAlignment="Center" Margin="10,0" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="/" Foreground="#484F58" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtLibTotalPages" Text="1" Foreground="#484F58" VerticalAlignment="Center" Margin="5,0,10,0"/>
                <Button x:Name="BtnLibNextPage" Content="&#x25B6;" Style="{StaticResource PaginationButtonStyle}" FontSize="18" Click="BtnLibNextPage_Click"/>
            </StackPanel>
        </Grid>

        <!-- Row 3: Scan Progress -->
        <Grid Grid.Row="3" x:Name="LibScanProgress" Margin="0,8,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource ProgressTrack}">
                <Border x:Name="LibScanProgressBar" Style="{StaticResource ProgressFill}"/>
            </Border>
            <TextBlock Grid.Column="1" x:Name="TxtLibScanStatus" Text="Escaneando..." Foreground="#8B949E" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>

        <!-- Detail Overlay (on top of everything) -->
        <Border x:Name="LibDetailOverlay" Grid.RowSpan="4" Background="#1C2128" CornerRadius="10" BorderBrush="#373E47" BorderThickness="1" ClipToBounds="True" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Blurred BG background -->
                <Image x:Name="LibDetailBg" Grid.RowSpan="2" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="LowQuality" Opacity="0.6" ClipToBounds="True"/>

                <!-- Scrim gradient overlay -->
                <Border Grid.RowSpan="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#AA0C0E1A" Offset="0"/>
                            <GradientStop Color="#CC0C0E1A" Offset="0.4"/>
                            <GradientStop Color="#E00B0D17" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Header: Back button + Title -->
                <Grid Grid.Row="0" Margin="16,12,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnLibDetailBack" Grid.Column="0" Content="&#x25C0; Volver"
                            Style="{StaticResource GhostButtonStyle}" FontSize="13" Height="32" Padding="10,0"
                            Click="BtnLibDetailBack_Click"/>
                    <TextBlock x:Name="TxtLibDetailTitle" Grid.Column="1" Text="" FontSize="26" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- Detail content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20,12,20,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Cover + Info -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="8" Background="#121212" BorderBrush="#373E47" BorderThickness="1" ClipToBounds="True">
                                <Image x:Name="LibDetailCover" Stretch="Uniform" Margin="4"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <TextBlock x:Name="LibDetailName" FontSize="28" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border x:Name="LibDetailSystemBadge" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                        <TextBlock x:Name="LibDetailSystem" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <Border Background="#8B949E33" CornerRadius="4" Padding="8,3" Margin="0,0,8,0" BorderBrush="#8B949E30" BorderThickness="1">
                                        <TextBlock x:Name="LibDetailGameId" FontSize="12" Foreground="#8B949E" FontFamily="Consolas"/>
                                    </Border>
                                    <Border Background="#82C8D825" CornerRadius="4" Padding="8,3" BorderBrush="#82C8D844" BorderThickness="1">
                                        <TextBlock x:Name="LibDetailRegion" FontSize="12" Foreground="#82C8D8"/>
                                    </Border>
                                </StackPanel>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Formato" Foreground="#8B949E" FontSize="14" Margin="0,0,12,6"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LibDetailFormat" Foreground="#C9D1D9" FontSize="14" FontWeight="SemiBold" Margin="0,0,24,6"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Tamaño" Foreground="#8B949E" FontSize="14" Margin="0,0,12,6"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" x:Name="LibDetailSize" Foreground="#C9D1D9" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Región" Foreground="#8B949E" FontSize="14" Margin="0,0,12,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LibDetailRegionMeta" Foreground="#C9D1D9" FontSize="14" FontWeight="SemiBold" Margin="0,0,24,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Partes" Foreground="#8B949E" FontSize="14" Margin="0,0,12,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="LibDetailParts" Foreground="#C9D1D9" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                </Grid>

                                <!-- CFG Info (visible when CFG exists) -->
                                <Border x:Name="LibCfgInfoPanel" Visibility="Collapsed" Margin="0,10,0,0" Padding="10" Background="#1A253550" CornerRadius="6" BorderBrush="#253550" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Información del CFG" Foreground="#8B949E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Género" Foreground="#6B6F80" FontSize="12" Margin="0,0,10,3"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LibCfgGenre" Foreground="#B8BAC5" FontSize="12" Margin="0,0,0,3"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Desarrollador" Foreground="#6B6F80" FontSize="12" Margin="0,0,10,3"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LibCfgDeveloper" Foreground="#B8BAC5" FontSize="12" Margin="0,0,0,3"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Lanzamiento" Foreground="#6B6F80" FontSize="12" Margin="0,0,10,3"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LibCfgRelease" Foreground="#B8BAC5" FontSize="12" Margin="0,0,0,3"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Modo V." Foreground="#6B6F80" FontSize="12" Margin="0,0,10,3"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LibCfgVmode" Foreground="#B8BAC5" FontSize="12" Margin="0,0,0,3"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Compat." Foreground="#6B6F80" FontSize="12" Margin="0,0,10,3"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LibCfgCompat" Foreground="#B8BAC5" FontSize="12" Margin="0,0,0,3"/>
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Descripción" Foreground="#6B6F80" FontSize="12" Margin="0,0,10,3" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="LibCfgDescription" Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Icon + Screenshots -->
                        <Grid Grid.Row="1" Margin="0,20,0,0" Height="160">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="6" Background="#121212" BorderBrush="#373E47" BorderThickness="1" ClipToBounds="True">
                                <Image x:Name="LibDetailIcon" Stretch="Uniform" Margin="8"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="LibDetailScreenshots" Height="150">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Cursor="Hand" BorderThickness="0" Background="Transparent" Padding="0"
                                                    Click="LibScreenshot_Click" Tag="{Binding}">
                                                <Border CornerRadius="8" Background="#121212" BorderBrush="#373E47" BorderThickness="1" Margin="0,0,10,0" Width="280" ClipToBounds="True">
                                                    <Image Source="{Binding}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Margin="4"/>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Row 2: Actions -->
                        <Border Grid.Row="2" Margin="0,16,0,0" Padding="12" Background="#2D333BAA" CornerRadius="6" BorderBrush="#373E47" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnLibDownloadArt" Content="Descargar ART" Style="{StaticResource AccentButtonStyle}" Height="34" Width="120" FontSize="12"
                                        Click="BtnLibDownloadArt_Click"/>
                                <Button Content="Eliminar" Style="{StaticResource DangerButtonStyle}" Height="34" Width="100" FontSize="12" Margin="8,0,0,0"
                                        Click="BtnLibDeleteGame_Click"/>
                                <Button Content="Config CFG" Style="{StaticResource MediumButton}" Height="34" Width="100" FontSize="12" Margin="8,0,0,0"
                                        Click="BtnLibEditCfg_Click"/>
                                <Button x:Name="BtnLibDownloadCfg" Content="Descargar CFG" Style="{StaticResource AccentButtonStyle}" Height="34" Width="110" FontSize="12" Margin="8,0,0,0"
                                        Click="BtnLibDownloadCfg_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- Screenshot popup overlay -->
                <Border x:Name="LibScreenshotPopup" Grid.RowSpan="2" Background="#E8080A14" Visibility="Collapsed"
                        MouseLeftButtonDown="LibScreenshotPopup_Click" Cursor="Hand">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="&#x2715; Cerrar" Foreground="#8B949E" FontSize="13"
                                   HorizontalAlignment="Right" Margin="0,12,16,0" IsHitTestVisible="False"/>
                        <Grid Grid.Row="1" Margin="40">
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="1200" MaxHeight="800"
                                    CornerRadius="8" ClipToBounds="True" Background="#0A0B0F" BorderBrush="#373E47" BorderThickness="1">
                                <Image x:Name="LibScreenshotFullImage" Stretch="Uniform" Margin="0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
