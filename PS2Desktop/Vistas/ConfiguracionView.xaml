<UserControl x:Class="PS2Desktop.Vistas.ConfiguracionView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              Background="{DynamicResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="40,30">
        <StackPanel>
            <!-- Header -->
            <StackPanel Margin="0,0,0,40">
                <TextBlock Text="Configuración" Foreground="{DynamicResource TextMainBrush}" FontSize="32" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="Personaliza la apariencia de tu PS2Desktop" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="14" Margin="0,0,0,0"/>
            </StackPanel>

            <!-- Preview Tarjeta de Juegos -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="25" Margin="0,0,0,25" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Vista Previa - Tarjetas de Juegos" Foreground="{DynamicResource TextMainBrush}" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Ajusta el tamaño de las tarjetas en la vista de juegos" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Preview Card con imagen -->
                        <Grid Grid.Column="0" Margin="0,0,30,0">
                            <Border x:Name="PreviewCard" Background="#1A2238" CornerRadius="10" Width="230" Height="280" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Effect="{DynamicResource ModernShadowEffect}">
                                <Grid>
                                    <Image Source="/Imagenes/juegosinportada.png" Stretch="Uniform"/>
                                </Grid>
                            </Border>

                            <!-- Width line (top) -->
                            <TextBlock x:Name="TxtWidthPreview" Text="230 px" Foreground="{DynamicResource AccentBrush}"
                                       FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-22,0,0"/>

                            <!-- Height line (right) -->
                            <TextBlock x:Name="TxtHeightPreview" Text="280 px" Foreground="{DynamicResource AccentBrush}"
                                       FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-42,0"/>
                        </Grid>

                        <!-- Sliders -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Ancho de tarjeta" Foreground="{DynamicResource TextMainBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Slider x:Name="SliderGameWidth" Minimum="150" Maximum="350" Value="230" TickFrequency="10" IsSnapToTickEnabled="True" 
                                    Height="24" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="TxtGameWidth" Text="230 px" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Alto de tarjeta" Foreground="{DynamicResource TextMainBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Slider x:Name="SliderGameHeight" Minimum="200" Maximum="450" Value="280" TickFrequency="10" IsSnapToTickEnabled="True"
                                    Height="24" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="TxtGameHeight" Text="280 px" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Tamaño de Cards de Temas -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="25" Margin="0,0,0,35" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Tamaño de Tarjetas de Temas" Foreground="{DynamicResource TextMainBrush}" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Ajusta el tamaño de las tarjetas en la vista de temas" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ancho" Foreground="{DynamicResource TextMainBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Slider x:Name="SliderThemeWidth" Minimum="150" Maximum="350" Value="230" TickFrequency="10" IsSnapToTickEnabled="True"
                                    Height="24" ValueChanged="Slider_ValueChanged"/>
                            <TextBlock x:Name="TxtThemeWidth" Text="230 px" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Alto" Foreground="{DynamicResource TextMainBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Slider x:Name="SliderThemeHeight" Minimum="150" Maximum="400" Value="300" TickFrequency="10" IsSnapToTickEnabled="True"
                                    Height="24" ValueChanged="Slider_ValueChanged"/>
                            <TextBlock x:Name="TxtThemeHeight" Text="300 px" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Botón Guardar con Icono -->
            <Button Click="BtnGuardar_Click" 
                    Background="{DynamicResource AccentBrush}" 
                    Foreground="White" 
                    FontSize="15" 
                    FontWeight="SemiBold"
                    Height="52" 
                    Cursor="Hand"
                    HorizontalAlignment="Left"
                    Padding="28,0,28,0"
                    BorderThickness="0"
                    ToolTip="Guardar configuración"
                    Margin="0,20,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="12"
                                Effect="{DynamicResource ModernShadowEffect}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Icono Guardar (Disquete SVG) -->
                                <Viewbox Grid.Column="0" Width="20" Height="20" Stretch="Uniform">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2v9.67z" 
                                              Fill="White"/>
                                    </Canvas>
                                </Viewbox>
                                
                                <!-- Texto -->
                                <TextBlock Grid.Column="2" 
                                           Text="Guardar configuración" 
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="15"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#004A9C"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>