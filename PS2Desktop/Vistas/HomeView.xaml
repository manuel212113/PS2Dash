<UserControl x:Class="PS2Desktop.Vistas.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="930"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Glow pulse animation -->
        <Storyboard x:Key="GlowPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="GlowEllipse" Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0.7" Duration="0:0:2"/>
            <DoubleAnimation Storyboard.TargetName="GlowEllipse" Storyboard.TargetProperty="(FrameworkElement.Width)"
                             From="250" To="350" Duration="0:0:2"/>
            <DoubleAnimation Storyboard.TargetName="GlowEllipse" Storyboard.TargetProperty="(FrameworkElement.Height)"
                             From="250" To="350" Duration="0:0:2"/>
        </Storyboard>

        <!-- Floating decoration animation -->
        <Storyboard x:Key="FloatAnim" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="FloatIcon1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="-15" Duration="0:0:3"/>
            <DoubleAnimation Storyboard.TargetName="FloatIcon2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="-12" Duration="0:0:2.5"/>
        </Storyboard>

        <!-- Card entrance slide-up -->
        <Storyboard x:Key="CardEntrance">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="40" To="0" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5"/>
        </Storyboard>

        <!-- Shimmer overlay -->
        <LinearGradientBrush x:Key="ShimmerBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00FFFFFF" Offset="0"/>
            <GradientStop Color="#15FFFFFF" Offset="0.5"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Light sweep beam animation -->
        <Storyboard x:Key="SweepAnim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SweepTransform" Storyboard.TargetProperty="X"
                             From="-350" To="1100" Duration="0:0:5"/>
        </Storyboard>

        <!-- Sweep gradient -->
        <LinearGradientBrush x:Key="SweepBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#00FFFFFF"/>
            <GradientStop Offset="0.3" Color="#00FFFFFF"/>
            <GradientStop Offset="0.45" Color="#25FFFFFF"/>
            <GradientStop Offset="0.55" Color="#25FFFFFF"/>
            <GradientStop Offset="0.7" Color="#00FFFFFF"/>
            <GradientStop Offset="1" Color="#00FFFFFF"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="True">
        <StackPanel Margin="30,0,30,30">

            <!-- ==================== HERO BANNER ==================== -->
            <Border CornerRadius="20" Height="240" Margin="0,20,0,0" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#0B0F24"/>
                        <GradientStop Offset="0.5" Color="#002A6E"/>
                        <GradientStop Offset="1" Color="#0055CC"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Glow effect -->
                    <Ellipse x:Name="GlowEllipse" Fill="#400055CC" Width="250" Height="250"
                             HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,80,0" Opacity="0.4"/>

                    <!-- Floating decorative icons -->
                    <Path x:Name="FloatIcon1" Fill="#20FFFFFF" Stretch="Uniform" Width="40" Height="40"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,60,0" Opacity="0.3"
                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z">
                        <Path.RenderTransform>
                            <TranslateTransform/>
                        </Path.RenderTransform>
                    </Path>
                    <Path x:Name="FloatIcon2" Fill="#15FFFFFF" Stretch="Uniform" Width="24" Height="24"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,200,40" Opacity="0.2"
                          Data="M21 6h-2v2h-2V6h-2V4h2V2h2v2h2v2zm-10 3c1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3 1.34 3 3 3zm0 4c-2.33 0-7 1.17-7 3.5V17h14v-1.5c0-2.33-4.67-3.5-7-3.5z">
                        <Path.RenderTransform>
                            <TranslateTransform/>
                        </Path.RenderTransform>
                    </Path>

                    <!-- Light sweep beam -->
                    <Rectangle Fill="{StaticResource SweepBrush}" Width="350" Stretch="UniformToFill"
                               HorizontalAlignment="Left" VerticalAlignment="Stretch" Opacity="0.5"
                               RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="SweepTransform" X="-350"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <!-- Content -->
                    <StackPanel VerticalAlignment="Center" Margin="40,0">
                        <!-- Logo + Title -->
                        <StackPanel Orientation="Horizontal">
                            <Border Width="56" Height="56" CornerRadius="14" Background="#1A2238" Margin="0,0,18,0">
                                <Image Source="/Imagenes/logops2app.png" Stretch="Uniform" Margin="8"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="PS2 Demo Downloader" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Descarga y gestiona las mejores demos y temas para tu PS2" 
                                           Foreground="#CCFFFFFF" FontSize="14" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="BtnExplorarDemos" Content="Explorar Demos" Width="160" Cursor="Hand"
                                    Background="#1A2238" Foreground="White" Height="40" FontWeight="SemiBold"
                                    BorderThickness="1" BorderBrush="#2A3A58">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#2A3A58"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#3A5A88"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnVerTemas" Content="Ver Temas" Margin="12,0,0,0"
                                    Background="#1A2238" Foreground="White" Height="40" Width="130" Cursor="Hand"
                                    BorderThickness="1" BorderBrush="#2A3A58">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#2A3A58"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#3A5A88"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- PS2 3D model -->
                    <Image x:Name="PS2ModelImage" Stretch="Uniform" Width="240" Height="240"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,140,0" Opacity="0.9"/>
                </Grid>
            </Border>

            <!-- ==================== STATS CARDS ==================== -->
            <Grid Margin="0,25,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Stat 1 -->
                <Border x:Name="StatCard1" Grid.Column="0" Margin="0,0,8,0" CornerRadius="16" Background="#131A30" Padding="20,18"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <Path Data="M21 6h-2v2h-2V6h-2V4h2V2h2v2h2v2zm-10 3c1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3 1.34 3 3 3zm0 4c-2.33 0-7 1.17-7 3.5V17h14v-1.5c0-2.33-4.67-3.5-7-3.5z"
                              Fill="#0055CC" Stretch="Uniform" Width="24" Height="24" Opacity="0.8"/>
                        <TextBlock x:Name="StatDemos" Text="0" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="Demos Disponibles" Foreground="#888E9E" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Stat 2 -->
                <Border x:Name="StatCard2" Grid.Column="1" Margin="8,0" CornerRadius="16" Background="#131A30" Padding="20,18"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <Path Data="M17.5,8A1.5,1.5 0 1,1 16,9.5A1.5,1.5 0 0,1 17.5,8 M12.5,5A1.5,1.5 0 1,1 11,6.5A1.5,1.5 0 0,1 12.5,5 M7.5,8A1.5,1.5 0 1,1 6,9.5A1.5,1.5 0 0,1 7.5,8 M7.5,14A1.5,1.5 0 1,1 6,15.5A1.5,1.5 0 0,1 7.5,14 M12.083 24A12 12 0 0 1 3.745 3.371 11.885 11.885 0 0 1 12.5.007 12.155 12.155 0 0 1 24.08 11.7a11.924 11.924 0 0 1-.775 4.552 1.888 1.888 0 0 1-1.377 1.177 1.912 1.912 0 0 1-1.769-.521l-.1-.1a3.567 3.567 0 0 0-6.089 2.553l.04 4.516-.924.077C12.753 23.978 12.421 24 12.083 24Z"
                              Fill="#00B4D8" Stretch="Uniform" Width="24" Height="24" Opacity="0.8"/>
                        <TextBlock x:Name="StatTemas" Text="0" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="Temas OPL" Foreground="#888E9E" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Stat 3 -->
                <Border x:Name="StatCard3" Grid.Column="2" Margin="8,0" CornerRadius="16" Background="#131A30" Padding="20,18"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <Path Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                               Fill="#8890A0" Stretch="Uniform" Width="24" Height="24" Opacity="0.8"/>
                        <TextBlock x:Name="StatRating" Text="0.0" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="Valoración Media" Foreground="#888E9E" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Stat 4 -->
                <Border x:Name="StatCard4" Grid.Column="3" Margin="8,0,0,0" CornerRadius="16" Background="#131A30" Padding="20,18"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V17h14v-1.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V17h6v-1.5c0-2.33-4.67-3.5-7-3.5z"
                              Fill="#00E676" Stretch="Uniform" Width="24" Height="24" Opacity="0.8"/>
                        <TextBlock x:Name="StatUsers" Text="0" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="Usuarios" Foreground="#888E9E" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== ÚLTIMAS DEMOS ==================== -->
            <StackPanel Margin="0,35,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <TextBlock Text="Últimas Demos" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <Path Data="M10,6L8.59,7.41L13.17,12l-4.58,4.59L10,18l6-6L10,6z"
                          Fill="#888E9E" Stretch="Uniform" Width="12" Margin="10,8,0,0"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Demo card 1 -->
                    <Border x:Name="DemoCard1" Grid.Column="0" Margin="0,0,10,0" CornerRadius="16" Background="#131A30" Cursor="Hand"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CardScale1" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Border Height="180" CornerRadius="16,16,0,0" Background="#1A2238" ClipToBounds="True">
                                <Grid>
                                    <Path Fill="#252D45" Stretch="Uniform" Width="60" Height="60" Opacity="0.4"
                                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Background="#0055CC" CornerRadius="0,12,0,0" 
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Padding="10,4">
                                        <TextBlock Text="NUEVO" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Margin="16,14">
                                <TextBlock Text="Demo ISO" Foreground="#0055CC" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="Próximamente" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                <TextBlock Text="Nueva demo en desarrollo" Foreground="#888E9E" FontSize="12" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Demo card 2 -->
                    <Border x:Name="DemoCard2" Grid.Column="1" Margin="10,0" CornerRadius="16" Background="#131A30" Cursor="Hand"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CardScale2" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Border Height="180" CornerRadius="16,16,0,0" Background="#1A2238" ClipToBounds="True">
                                <Grid>
                                    <Path Fill="#252D45" Stretch="Uniform" Width="60" Height="60" Opacity="0.4"
                                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Background="#00B4D8" CornerRadius="0,12,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Padding="10,4">
                                        <TextBlock Text="POPULAR" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Margin="16,14">
                                <TextBlock Text="Edición ISO" Foreground="#00B4D8" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="Próximamente" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                <TextBlock Text="Demo popular en desarrollo" Foreground="#888E9E" FontSize="12" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Demo card 3 -->
                    <Border x:Name="DemoCard3" Grid.Column="2" Margin="10,0,0,0" CornerRadius="16" Background="#131A30" Cursor="Hand"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CardScale3" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Border Height="180" CornerRadius="16,16,0,0" Background="#1A2238" ClipToBounds="True">
                                <Grid>
                                    <Path Fill="#252D45" Stretch="Uniform" Width="60" Height="60" Opacity="0.4"
                                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Background="#2A2F42" CornerRadius="0,12,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Padding="10,4">
                                        <TextBlock Text="PRÓXIMO" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Margin="16,14">
                                <TextBlock Text="Demo ISO" Foreground="#8890A0" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="Próximamente" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                <TextBlock Text="Nueva demo en camino" Foreground="#888E9E" FontSize="12" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ==================== ACCESO RÁPIDO ==================== -->
            <StackPanel Margin="0,35,0,0">
                <TextBlock Text="Acceso Rápido" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Quick access: Temas -->
                    <Border x:Name="QACard1" Grid.Column="0" Margin="0,0,10,0" CornerRadius="16" Background="#131A30" Padding="25" Cursor="Hand">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="QAScale1" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M17.5,8A1.5,1.5 0 1,1 16,9.5A1.5,1.5 0 0,1 17.5,8 M12.5,5A1.5,1.5 0 1,1 11,6.5A1.5,1.5 0 0,1 12.5,5 M7.5,8A1.5,1.5 0 1,1 6,9.5A1.5,1.5 0 0,1 7.5,8 M7.5,14A1.5,1.5 0 1,1 6,15.5A1.5,1.5 0 0,1 7.5,14 M12.083 24A12 12 0 0 1 3.745 3.371 11.885 11.885 0 0 1 12.5.007 12.155 12.155 0 0 1 24.08 11.7a11.924 11.924 0 0 1-.775 4.552 1.888 1.888 0 0 1-1.377 1.177 1.912 1.912 0 0 1-1.769-.521l-.1-.1a3.567 3.567 0 0 0-6.089 2.553l.04 4.516-.924.077C12.753 23.978 12.421 24 12.083 24Z"
                                  Fill="#0055CC" Stretch="Uniform" Width="36" Height="36"/>
                            <TextBlock Text="Temas OPL" Foreground="White" FontSize="15" FontWeight="SemiBold" 
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="Personaliza tu PS2" Foreground="#888E9E" FontSize="12" 
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick access: Juegos -->
                    <Border x:Name="QACard2" Grid.Column="1" Margin="10,0" CornerRadius="16" Background="#131A30" Padding="25" Cursor="Hand">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="QAScale2" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M12.006 3.212C6.888 3.212 1.155 4.343 1 12.323c.047 2.322 .562 5.382 1.607 6.983 .667 1.021 1.849 1.567 3.089 1.426 1.23-.14 2.254-.932 2.671-2.067 .6-1.639 1.757-2.41 3.625-2.424 1.845 .015 3.036 .823 3.643 2.472 .415 1.126 1.57 2.077 3.041 2.077 1.09 0 2.099-.53 2.696-1.438 1.06-1.607 1.581-4.688 1.628-7.067-.152-7.984-6.09-9.072-10.994-9.072Z"
                                  Fill="#00B4D8" Stretch="Uniform" Width="36" Height="36"/>
                            <TextBlock Text="Juegos" Foreground="White" FontSize="15" FontWeight="SemiBold" 
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="Explora demos" Foreground="#888E9E" FontSize="12" 
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick access: Comunidad -->
                    <Border x:Name="QACard3" Grid.Column="2" Margin="10,0,0,0" CornerRadius="16" Background="#131A30" Padding="25" Cursor="Hand">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="QAScale3" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V17h14v-1.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V17h6v-1.5c0-2.33-4.67-3.5-7-3.5z"
                                  Fill="#00E676" Stretch="Uniform" Width="36" Height="36"/>
                            <TextBlock Text="Comunidad" Foreground="White" FontSize="15" FontWeight="SemiBold" 
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="Conecta con otros" Foreground="#888E9E" FontSize="12" 
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Text="PS2 Desktop App © 2026" Foreground="#555" FontSize="11" 
                       HorizontalAlignment="Center" Margin="0,40,0,10"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
