<Window x:Class="PS2Desktop.Vistas.ResetPasswordView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuperar Contraseña" Height="460" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="#121212" WindowStyle="None"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="16" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="16" Background="#121212" BorderThickness="1" BorderBrush="#2A2F42">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <Grid>
                    <TextBlock Text="Recuperar contraseña" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Left"/>
                    <Button Content="✕" Foreground="#888E9E" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" FontSize="18" Cursor="Hand" Click="BtnCerrar_Click"/>
                </Grid>
                <TextBlock x:Name="TxtStepDesc" Text="Ingresa tu correo para recibir un código de verificación" 
                           Foreground="#888E9E" FontSize="13" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Step 1: Email -->
            <StackPanel x:Name="Step1Panel" Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Correo electrónico" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Border Background="#1A1A1A" CornerRadius="10" BorderBrush="#252525" BorderThickness="1" Padding="15,12">
                    <TextBox x:Name="TxtEmail" Foreground="White" Background="Transparent" BorderThickness="0"
                             FontSize="14" CaretBrush="#0078F2"/>
                </Border>
                <Button Content="Enviar código" Click="BtnEnviarCodigo_Click" Height="44" Margin="0,20,0,0" Cursor="Hand"
                        Background="#0078F2" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0055CC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="LblStatus" Foreground="#888E9E" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Step 2: Code + New Password -->
            <StackPanel x:Name="Step2Panel" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Código de verificación" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Border Background="#1A1A1A" CornerRadius="10" BorderBrush="#252525" BorderThickness="1" Padding="15,12">
                    <TextBox x:Name="TxtCode" Foreground="White" Background="Transparent" BorderThickness="0"
                             FontSize="14" CaretBrush="#0078F2" MaxLength="8"/>
                </Border>
                <TextBlock Text="Nueva contraseña" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,15,0,10"/>
                <Border Background="#1A1A1A" CornerRadius="10" BorderBrush="#252525" BorderThickness="1" Padding="15,12">
                    <PasswordBox x:Name="TxtNewPassword" Foreground="White" Background="Transparent" BorderThickness="0"
                                 FontSize="14" CaretBrush="#0078F2"/>
                </Border>
                <Button Content="Restablecer contraseña" Click="BtnResetPassword_Click" Height="44" Margin="0,20,0,0" Cursor="Hand"
                        Background="#0078F2" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0055CC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="LblStep2Status" Foreground="#888E9E" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>