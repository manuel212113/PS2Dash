<UserControl x:Class="PS2Desktop.Vistas.DetalleTemaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1200"
             Background="#0A0A10">

    <UserControl.Resources>
        <Viewbox x:Key="IconPause" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Fill="White" Data="M19 0H5C2.243 0 0 2.243 0 5v14c0 2.757 2.243 5 5 5h14c2.757 0 5-2.243 5-5V5c0-2.757-2.243-5-5-5Zm3 19c0 1.654-1.346 3-3 3H5c-1.654 0-3-1.346-3-3V5c0-1.654 1.346-3 3-3h14c1.654 0 3 1.346 3 3v14Zm-7-11v8c0 .553-.447 1-1 1s-1-.447-1-1V8c0-.552 .447-1 1-1s1 .448 1 1Zm-4 0v8c0 .553-.448 1-1 1s-1-.447-1-1V8c0-.552 .448-1 1-1s1 .448 1 1Z"/>
            </Canvas>
        </Viewbox>

        <Viewbox x:Key="IconPlay" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Fill="White" Data="m19 24h-14a5.006 5.006 0 0 1 -5-5v-14a5.006 5.006 0 0 1 5-5h14a5.006 5.006 0 0 1 5 5v14a5.006 5.006 0 0 1 -5 5zm-14-22a3 3 0 0 0 -3 3v14a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-14a3 3 0 0 0 -3-3zm4.342 15.005a2.368 2.368 0 0 1 -1.186-.323 2.313 2.313 0 0 1 -1.164-2.021v-5.322a2.337 2.337 0 0 1 3.5-2.029l5.278 2.635a2.336 2.336 0 0 1 .049 4.084l-5.376 2.687a2.2 2.2 0 0 1 -1.101.289zm-.025-8a.314.314 0 0 0 -.157.042.327.327 0 0 0 -.168.292v5.322a.337.337 0 0 0 .5.293l5.376-2.688a.314.314 0 0 0 .12-.266.325.325 0 0 0 -.169-.292l-5.274-2.635a.462.462 0 0 0 -.228-.068z"/>
            </Canvas>
        </Viewbox>

        <Viewbox x:Key="IconVolOn" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Fill="White" Data="M20.807 4.29a1 1 0 0 0-1.415 1.415 8.913 8.913 0 0 1 0 12.59 1 1 0 0 0 1.415 1.415A10.916 10.916 0 0 0 20.807 4.29Z"/>
                <Path Fill="White" Data="M18.1 7.291A1 1 0 0 0 16.68 8.706a4.662 4.662 0 0 1 0 6.588A1 1 0 0 0 18.1 16.709 6.666 6.666 0 0 0 18.1 7.291Z"/>
                <Path Fill="White" Data="M13.82.2A12.054 12.054 0 0 0 6.266 5H5a5.008 5.008 0 0 0-5 5v4a5.008 5.008 0 0 0 5 5H6.266A12.059 12.059 0 0 0 13.82 23.8a.917.917 0 0 0 .181.017 1 1 0 0 0 1-1V1.186A1 1 0 0 0 13.82.2ZM13 21.535a10.083 10.083 0 0 1-5.371-4.08A1 1 0 0 0 6.792 17H5a3 3 0 0 1-3-3V10A3 3 0 0 1 5 7h1.8a1 1 0 0 0 .837-.453A10.079 10.079 0 0 1 13 2.465Z"/>
            </Canvas>
        </Viewbox>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="TrackBackground" Height="4" Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#00ADFF" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="MainScrollViewer" 
              VerticalScrollBarVisibility="Auto" 
              Focusable="True"
              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
              PreviewKeyDown="MainScrollViewer_PreviewKeyDown">

        <Grid Margin="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,30">
                <TextBlock Text="PS5 Official Theme" Foreground="White" FontSize="42" FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,25">
                    <TextBlock Text="★ ★ ★ ★" Foreground="White" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="☆" Foreground="Gray" FontSize="16"/>
                    <TextBlock Text="4.2" Foreground="#00ADFF" FontSize="14" FontWeight="Bold" Margin="8,0,20,0" VerticalAlignment="Center"/>
                    <TextBlock Text="🧩 Rompecabezas desafiantes" Foreground="#AAA" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,35,0">
                        <TextBlock Text="Información general" Foreground="White" FontSize="16" FontWeight="SemiBold" Cursor="Hand"/>
                        <Border Height="3" Background="#00ADFF" Margin="0,8,0,0" CornerRadius="2"/>
                    </StackPanel>
                    <TextBlock Text="Complementos" Foreground="Gray" FontSize="16" FontWeight="SemiBold" Margin="0,0,35,0" Cursor="Hand"/>
                    <TextBlock Text="Logros" Foreground="Gray" FontSize="16" FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="500"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="20,20,0,0" Background="Black" ClipToBounds="True">
                        <vlc:VideoView x:Name="VideoPlayerDetalle" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Border>

                    <Border Grid.Row="1" Background="#CC1C2030" CornerRadius="0,0,20,20" Padding="20,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Slider x:Name="TimelineSlider" 
                                    Style="{StaticResource ModernSlider}" 
                                    Maximum="100"
                                    Thumb.DragStarted="TimelineSlider_DragStarted"
                                    Thumb.DragCompleted="TimelineSlider_DragCompleted"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="btnPlayPause" 
                                        Content="{StaticResource IconPlay}" 
                                        Width="30" Height="30" 
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        Click="btnPlayPause_Click" 
                                        Cursor="Hand"/>

                                <Button x:Name="btnMute" 
                                        Content="{StaticResource IconVolOn}" 
                                        Width="25" Height="30" 
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        Margin="15,0" 
                                        Click="btnMute_Click" 
                                        Cursor="Hand"/>

                                <TextBlock x:Name="lblTime" Text="0:00" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text=" / " Foreground="Gray" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblTotalTime" Text="0:00" Foreground="Gray" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <UniformGrid Grid.Row="1" Columns="3" Margin="0,20,0,0">
                    <Border Height="120" CornerRadius="10" Background="#1C2030" Margin="5" BorderThickness="2" BorderBrush="#00ADFF"/>
                    <Border Height="120" CornerRadius="10" Background="#1C2030" Margin="5"/>
                    <Border Height="120" CornerRadius="10" Background="#1C2030" Margin="5"/>
                </UniformGrid>
            </Grid>

            <StackPanel Grid.Row="1" Grid.Column="1">
                <Border Background="#1C2030" CornerRadius="20" Padding="25">
                    <StackPanel>
                        <TextBlock Text="GRATIS" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        <Button Content="CONSEGUIR" Margin="0,20,0,0" Height="50" Background="#00ADFF" Foreground="White" FontWeight="Bold" Cursor="Hand" Focusable="False"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,40,0,0">
                <Separator Background="#33FFFFFF" Margin="0,0,0,30"/>
                <TextBlock Text="Descripción" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
                <TextBlock TextWrapping="Wrap" Foreground="#AAA" FontSize="16" LineHeight="24">
                    The Stone of Madness is a real-time tactical stealth game set in an 18th-century Spanish Monastery. 
                    Five prisoners pool their skills and resources to face their phobias, stave off insanity, and find a way to escape.
                </TextBlock>
                <Grid Height="600">
                    <TextBlock Text="Información adicional y requisitos..." Foreground="#555" Margin="0,20"/>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>