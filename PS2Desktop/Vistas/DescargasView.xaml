<UserControl x:Class="PS2Desktop.Vistas.DescargasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             Loaded="UserControl_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" BorderThickness="0" Margin="30,30,30,0">
        <StackPanel x:Name="DownloadsPanel">
            <!-- Empty state -->
            <Border x:Name="EmptyState" CornerRadius="16" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Margin="0,60,0,0"
                    Background="#00FFFFFF" BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="📥" FontSize="64" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sin descargas" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="20"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    <TextBlock Text="Agrega un enlace de MediaFire para empezar" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Loader -->
            <Grid x:Name="LoaderOverlay" Background="#00000080" HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Resolviendo enlace..." Foreground="{DynamicResource TextMainBrush}" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
