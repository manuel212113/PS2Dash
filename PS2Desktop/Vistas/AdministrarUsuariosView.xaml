<UserControl x:Class="PS2Desktop.Vistas.AdministrarUsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="40,30">
        <StackPanel>
            <StackPanel Margin="0,0,0,35">
                <TextBlock Text="Administrar Usuarios" Foreground="{DynamicResource TextMainBrush}" FontSize="32" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="Gestiona los usuarios y sus permisos" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="14"/>
            </StackPanel>

            <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="0" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <!-- Header de la tabla -->
                    <Border Background="{DynamicResource CardAltBrush}" CornerRadius="16,16,0,0">
                        <Grid Margin="20,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Usuario" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="Rol" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="Acción" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,20,0"/>
                        </Grid>
                    </Border>

                    <!-- Lista de usuarios -->
                    <ItemsControl x:Name="UsersList" Margin="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar -->
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentBrush}">
                                            <Border.Clip>
                                                <EllipseGeometry RadiusX="16" RadiusY="16" Center="16,16"/>
                                            </Border.Clip>
                                            <Image Source="{Binding AvatarSource}" Stretch="UniformToFill" Width="32" Height="32"/>
                                        </Border>

                                        <!-- Nombre y email -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextMainBrush}" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Email}" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="11"/>
                                        </StackPanel>

                                        <!-- Rol actual con badge -->
                                        <Border Grid.Column="2" VerticalAlignment="Center"
                                                Background="{Binding RoleColor}" CornerRadius="6" Padding="10,4" Width="Auto" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding RoleLabel}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Botón cambiar rol -->
                                        <Button Grid.Column="3" VerticalAlignment="Center" Cursor="Hand" Padding="0" BorderThickness="0"
                                                Visibility="{Binding CanChangeRole, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Click="BtnCambiarRol_Click" Tag="{Binding Id}">
                                            <Border Background="{DynamicResource CardLightBrush}" CornerRadius="8" Padding="12,6">
                                                <TextBlock Text="{Binding ToggleRoleLabel}" Foreground="{DynamicResource TextMainBrush}" 
                                                           FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyState" Text="No hay usuarios para mostrar" 
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,40" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>