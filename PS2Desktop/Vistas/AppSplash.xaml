<Window x:Class="PS2Desktop.Vistas.AppSplash"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PS2 Dash" Height="500" Width="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#121212"
        Loaded="Window_Loaded">

    <Grid>
        <!-- Glow background -->
        <Grid Margin="0,0,80,80" VerticalAlignment="Center" HorizontalAlignment="Center"
              Width="760" Height="580" IsHitTestVisible="False">
            <Ellipse Width="500" Height="500" Fill="#FF6B3520" Opacity="0.15"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-100,0,0"/>
            <Ellipse Width="400" Height="400" Fill="#0033AA" Opacity="0.1"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-50,-50"/>
        </Grid>

        <!-- Main splash panel -->
        <Border CornerRadius="24" Width="680" Height="500"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderThickness="1" BorderBrush="#2A2F42">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== LEFT PANEL (Black) ===== -->
                <Border Grid.Column="0" Background="#121212" CornerRadius="24,0,0,24">
                    <Grid Margin="28,28,24,28">
                        <StackPanel VerticalAlignment="Top">
                            <!-- PS2 Dash logo -->
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="PS2" Foreground="White" FontSize="32" FontWeight="Bold"
                                           FontFamily="{StaticResource GoogleSans}"/>
                                <TextBlock Text="Dash" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                           FontFamily="{StaticResource GoogleSans}" Opacity="0.7" Margin="0,-2,0,0"/>
                            </StackPanel>

                            <!-- Info text -->
                            <StackPanel Margin="0,28,0,0">
                                <TextBlock Text="Presentado por:" Foreground="#5A6A78" FontSize="10"
                                           FontFamily="{StaticResource GoogleSans}"/>
                                <TextBlock Text="Manuel Toro" Foreground="#8890A0" FontSize="11" FontWeight="SemiBold"
                                           FontFamily="{StaticResource GoogleSans}" Margin="0,2,0,0"/>
                                <TextBlock Text="Temas y Juegos para tu" Foreground="#5A6A78" FontSize="10"
                                           FontFamily="{StaticResource GoogleSans}" Margin="0,12,0,0"/>
                                <TextBlock Text="Consola de Nueva Generación (de 2000)" Foreground="#5A6A78" FontSize="10"
                                           FontFamily="{StaticResource GoogleSans}"/>
                                <TextBlock Text="© 2026. Todos los derechos reservados." Foreground="#3A3A4A" FontSize="9"
                                           FontFamily="{StaticResource GoogleSans}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Loading indicator -->
                        <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <TextBlock x:Name="LblLoading" Text="Cargando Temas" Foreground="White" Opacity="0.5"
                                       FontSize="12" FontFamily="{StaticResource GoogleSans}"/>
                            <Border Height="2" Background="#1A2238" CornerRadius="1" Margin="0,8,0,0" ClipToBounds="True">
                                <Border x:Name="ProgressFill" Height="2" Background="#0055CC" CornerRadius="1"
                                        HorizontalAlignment="Left" Width="260" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </StackPanel>

                        <!-- PS2 controller button icons -->
                        <Canvas Width="110" Height="70" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                Margin="0,0,-8,0" Opacity="0.2">
                            <Polygon Points="12,8 6,20 18,20" Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                     Canvas.Left="72" Canvas.Top="26"/>
                            <Ellipse Width="14" Height="14" Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                     Canvas.Left="44" Canvas.Top="40"/>
                            <Line X1="6" Y1="6" X2="18" Y2="18" Stroke="White" StrokeThickness="1.5" Canvas.Left="2" Canvas.Top="36"/>
                            <Line X1="18" Y1="6" X2="6" Y2="18" Stroke="White" StrokeThickness="1.5" Canvas.Left="2" Canvas.Top="36"/>
                            <Rectangle Width="14" Height="14" Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                       Canvas.Left="10" Canvas.Top="20"/>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- ===== RIGHT PANEL (Video 360) ===== -->
                <Border Grid.Column="1" Background="#121212" CornerRadius="0,24,24,0" ClipToBounds="True">
                    <Grid>
                        <MediaElement x:Name="SplashVideo"
                                      Source="Videos/splash.mp4"
                                      Stretch="UniformToFill"
                                      LoadedBehavior="Play" UnloadedBehavior="Stop"
                                      MediaFailed="SplashVideo_MediaFailed"/>
                        <!-- Fallback when video is missing -->
                        <Border x:Name="VideoFallback" Visibility="Collapsed"
                                Background="#121212">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="PS2" Foreground="#0055CC" FontSize="48" FontWeight="Bold"
                                           FontFamily="{StaticResource GoogleSans}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Dash" Foreground="White" FontSize="24" FontWeight="SemiBold"
                                           FontFamily="{StaticResource GoogleSans}" HorizontalAlignment="Center" Opacity="0.7"/>
                                <TextBlock Text="Video no disponible" Foreground="#5A6A78" FontSize="11"
                                           FontFamily="{StaticResource GoogleSans}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="BtnMute" Width="32" Height="32" Cursor="Hand"
                                Background="#80000000" CornerRadius="16"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,10,10,0" MouseDown="BtnMute_MouseDown">
                            <TextBlock x:Name="MuteIcon" Text="🔊" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
