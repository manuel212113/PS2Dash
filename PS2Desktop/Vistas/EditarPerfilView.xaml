<UserControl x:Class="PS2Desktop.Vistas.EditarPerfilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="40,30">
        <StackPanel>
            <!-- Header -->
            <StackPanel Margin="0,0,0,40">
                <TextBlock Text="Editar Perfil" Foreground="{DynamicResource TextMainBrush}" FontSize="32" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="Actualiza tu información personal" Foreground="{DynamicResource TextSecundarioBrush}" FontSize="14"/>
            </StackPanel>

            <!-- Tarjeta de información del perfil -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="30" Margin="0,0,0,25" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <!-- Avatar actual -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,30">
                        <Border x:Name="AvatarBorder" Width="100" Height="100" CornerRadius="50" 
                                Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center">
                            <Border.Clip>
                                <EllipseGeometry RadiusX="50" RadiusY="50" Center="50,50"/>
                            </Border.Clip>
                            <Image x:Name="AvatarImage" Stretch="UniformToFill" Width="100" Height="100"/>
                        </Border>
                        <TextBlock x:Name="TxtEmail" Foreground="{DynamicResource TextSecundarioBrush}" 
                                   FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Campo: Nombre de usuario -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Nombre de usuario" Foreground="{DynamicResource TextMainBrush}" 
                                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource InputBrush}" CornerRadius="10" 
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Padding="15,12">
                            <TextBox x:Name="TxtDisplayName" 
                                     Foreground="{DynamicResource TextMainBrush}" 
                                     Background="Transparent" 
                                     BorderThickness="0"
                                     FontSize="15"
                                     CaretBrush="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Campo: Correo electrónico (solo lectura) -->
                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Correo electrónico" Foreground="{DynamicResource TextMainBrush}" 
                                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource InputBrush}" CornerRadius="10" 
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Padding="15,12">
                            <TextBox x:Name="TxtEmailInput" 
                                     Foreground="{DynamicResource TextSecundarioBrush}" 
                                     Background="Transparent" 
                                     BorderThickness="0"
                                     FontSize="15"
                                     IsReadOnly="True"/>
                        </Border>
                        <TextBlock Text="El correo electrónico no se puede cambiar" 
                                   Foreground="{DynamicResource TextMutedBrush}" 
                                   FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Botón Guardar -->
                    <Button Click="BtnGuardar_Click" 
                            Background="{DynamicResource AccentBrush}" 
                            Foreground="White" 
                            FontSize="15" 
                            FontWeight="SemiBold"
                            Height="48" 
                            Cursor="Hand"
                            HorizontalAlignment="Left"
                            Padding="30,0,30,0"
                            BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" 
                                        Background="{TemplateBinding Background}" 
                                        CornerRadius="10"
                                        Effect="{DynamicResource ModernShadowEffect}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Icono -->
                                        <Viewbox Grid.Column="0" Width="18" Height="18" Stretch="Uniform">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2v9.67z" 
                                                      Fill="White"/>
                                            </Canvas>
                                        </Viewbox>
                                        
                                        <TextBlock Grid.Column="2" Text="Guardar cambios" 
                                                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#004A9C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>