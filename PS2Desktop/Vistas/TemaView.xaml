<UserControl x:Class="PS2Desktop.Vistas.TemaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- Animación de rotación para el loader -->
        <Storyboard x:Key="SpinnerAnimation" RepeatBehavior="Forever">
            <DoubleAnimation 
                Storyboard.TargetName="SpinnerEllipse" 
                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" 
                From="0" 
                To="360" 
                Duration="0:0:1.5" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- Contenido principal -->
        <Grid x:Name="mainContent" Margin="30,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Grid Grid.Row="0" Margin="0,15,0,15">
                <StackPanel Orientation="Horizontal" Cursor="Hand">
                    <TextBlock Text="Temas de OPL" Foreground="White" FontSize="26" FontWeight="Bold"/>
                    <Path Data="M10,6L8.59,7.41L13.17,12l-4.58,4.59L10,18l6-6L10,6z" 
                          Fill="White" Opacity="0.7" Stretch="Uniform" Width="12" Margin="10,6,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Height="36"
                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Width="240">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                  Fill="{DynamicResource TextMutedBrush}" Stretch="Uniform" Width="14" Margin="0,0,8,0"
                                  VerticalAlignment="Center"/>
                             <TextBox x:Name="TxtSearch" Grid.Column="1"
                                      ToolTip="Ctrl+F para buscar"
                                      Text="Buscar temas..." Foreground="{DynamicResource TextMutedBrush}"
                                      Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                      FontSize="13" CaretBrush="{DynamicResource AccentBrush}"
                                     GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus"
                                     TextChanged="TxtSearch_TextChanged" KeyDown="TxtSearch_KeyDown"/>
                        </Grid>
                    </Border>

                    <ComboBox x:Name="CboSort" Margin="12,0,0,0" Width="140" Height="36"
                              Style="{StaticResource DarkComboBoxStyle}"
                              SelectionChanged="CboSort_SelectionChanged">
                        <ComboBoxItem Content="Más recientes" Tag="date_desc" IsSelected="True"/>
                        <ComboBoxItem Content="Más antiguos" Tag="date_asc"/>
                        <ComboBoxItem Content="Nombre A-Z" Tag="name_asc"/>
                        <ComboBoxItem Content="Nombre Z-A" Tag="name_desc"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnPrevPage" Content="&#x25C0;" Click="BtnPrevPage_Click"
                            Style="{StaticResource PaginationButtonStyle}" FontSize="18"/>
                    <TextBlock x:Name="TxtPageInfo" Text="1" Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
                    <TextBlock Text="/" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalPages" Text="1" Foreground="White" VerticalAlignment="Center" Margin="5,0,10,0"/>
                    <Button x:Name="BtnNextPage" Content="&#x25B6;" Click="BtnNextPage_Click"
                            Style="{StaticResource PaginationButtonStyle}" FontSize="18"/>
                </StackPanel>
            </Grid>

            <!-- ScrollViewer que contiene el WrapPanel de temas -->
            <ScrollViewer Grid.Row="1" x:Name="TemasScrollViewer" VerticalScrollBarVisibility="Hidden" Focusable="True">
                <Grid>
                    <WrapPanel x:Name="temesPanel" IsItemsHost="False" />
                    <WrapPanel x:Name="skeletonPanel" Margin="0,0,0,30" Visibility="Collapsed">
                        <Border Width="230" Height="300" Margin="0,0,20,30" Style="{StaticResource SkeletonRect}" CornerRadius="12"/>
                        <Border Width="230" Height="300" Margin="0,0,20,30" Style="{StaticResource SkeletonRect}" CornerRadius="12"/>
                        <Border Width="230" Height="300" Margin="0,0,20,30" Style="{StaticResource SkeletonRect}" CornerRadius="12"/>
                        <Border Width="230" Height="300" Margin="0,0,20,30" Style="{StaticResource SkeletonRect}" CornerRadius="12"/>
                        <Border Width="230" Height="300" Margin="0,0,20,30" Style="{StaticResource SkeletonRect}" CornerRadius="12"/>
                        <Border Width="230" Height="300" Margin="0,0,20,30" Style="{StaticResource SkeletonRect}" CornerRadius="12"/>
                    </WrapPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Empty state -->
        <Grid x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="M21 3H3C1.9 3 1 3.9 1 5V19C1 20.1 1.9 21 3 21H21C22.1 21 23 20.1 23 19V5C23 3.9 22.1 3 21 3ZM21 19H3V5H21V19ZM13 14H17L12 19L7 14H11V10H13V14Z"
                      Fill="#2A3A58" Stretch="Uniform" Width="80" Height="80" Margin="0,0,0,20"/>
                <TextBlock x:Name="EmptyTitle" Text="No hay temas disponibles" Foreground="#8890A0" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptySubtitle" Text="Los temas aparecerán aquí cuando sean agregados" Foreground="#5A6A78" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Loader / Spinner -->
        <Grid x:Name="LoaderOverlay" Background="#00000080" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Spinner circular -->
                <Ellipse 
                    x:Name="SpinnerEllipse"
                    Width="50" 
                    Height="50" 
                    Stroke="#0078F2" 
                    StrokeThickness="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,20"
                    RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Texto de carga -->
                <TextBlock 
                    Text="Cargando temas..." 
                    Foreground="White" 
                    FontSize="16"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                <TextBlock 
                    Text="Espera un momento por favor" 
                    Foreground="#888E9E" 
                    FontSize="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>